config INTERCONNECT_MTK
	bool "MediaTek interconnect drivers"
	depends on ARCH_MEDIATEK || COMPILE_TEST
	help
	  Support for MediaTek's bus interconnect hardware.

config INTERCONNECT_MTK_DVFSRC_EMI
	tristate "MediaTek DVFSRC EMI interconnect driver"
	depends on INTERCONNECT_MTK && MTK_DVFSRC
	help
	  This is a driver for the MediaTek External Memory Interface
	  interconnect on SoCs equipped with the integrated Dynamic
	  Voltage Frequency Scaling Resource Collector (DVFSRC) MCU

config INTERCONNECT_MTK_MT8183
	tristate "MediaTek MT8183 interconnect driver"
	depends on INTERCONNECT_MTK_DVFSRC_EMI
	help
	  This is a driver for the MediaTek bus interconnect on MT8183-based
	  platforms.

config INTERCONNECT_MTK_MT8195
	tristate "MediaTek MT8195 interconnect driver"
	depends on INTERCONNECT_MTK_DVFSRC_EMI
	help
	  This is a driver for the MediaTek bus interconnect on MT8195-based
	  platforms.

config INTERCONNECT_MTK_MT8196
	tristate "MediaTek MT8196 interconnect driver"
	depends on INTERCONNECT_MTK_DVFSRC_EMI
	help
	  This is a driver for the MediaTek bus interconnect on MT8196-based
	  platforms.

config INTERCONNECT_MTK_EMI
	tristate "MediaTek DVFSRC EMI interconnect driver"
	depends on INTERCONNECT_MTK && MTK_DVFSRC && OF
	help
	  This is a driver for the MediaTek External Memory Interface
	  interconnect on DVFSRC-based platforms.  It is registered as a
	  child of the DVFSRC device and is referenced as <&dvfsrc ...>.

config INTERCONNECT_MTK_MMQOS_COMMON
	tristate "MediaTek MMQoS interconnect support"
	select INTERCONNECT_MTK_EXTENSION
	help
	  Support for multimedia QoS in MediaTek's SoCs.  The MMQoS
	  (Multimedia Quality of Service) interconnect driver collects
	  bandwidth requests from multimedia users, such as display, camera,
	  MDP and video codec, and configures the SMI settings dynamically
	  according to the aggregated bandwidth.

config INTERCONNECT_MTK_MMQOS_MT6895
	tristate "MediaTek MT6895 MMQoS interconnect driver"
	depends on INTERCONNECT_MTK && MTK_SMI
	select INTERCONNECT_MTK_MMQOS_COMMON
	help
	  Support MT6895 multimedia QoS.
