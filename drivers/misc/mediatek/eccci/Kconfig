menuconfig MTK_CCCI_MAINLINE
	bool "MTK CCCI cellular modem driver (mainline port, built-in)"
	depends on ARCH_MEDIATEK
	depends on NET
	help
	  Evolved CCCI driver + ccmni ported from the Xiaomi MT6895 vendor
	  kernel for mainline MT6895 (xaga/pearl). Probes the "mediatek,mddriver"
	  DT node and brings up the cellular modem control/data channels.
	  Built-in: probes automatically at boot, no module loading needed.

config MTK_CCCI_MAINLINE_DATAPATH_HIF
	bool "MT6895 CCCI data-path HIFs (CLDMA + DPMAIF) built-in"
	depends on MTK_CCCI_MAINLINE
	default n
	help
	  CLDMA and DPMAIF carry the MD data path.  The proven xaga/pearl
	  bring-up loads only the CCIF HIF: the modem reaches the handshake
	  and exchanges the runtime data over CCIF, and the CLDMA/DPMAIF
	  probes touch hardware this port has not validated yet.  Say N to
	  keep them out of the built-in image; build them as modules
	  (CONFIG_MTK_CCCI_MAINLINE_DATAPATH_HIF=m) for data-path work.
