# Minimal mt6895-platform Xiaomi Redmi Note 12T Pro (pearl) base config fragment
# Merge on top of the arm64 defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig \
#       arch/arm64/configs/pearl.config
#
# This fragment intentionally only enables the SoC base pieces added so far.
# Peripheral/display/audio/GPU options will be added in later cleanup stages.

CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT6895=y
CONFIG_COMMON_CLK_MT6895=y

# MediaTek CPUFreq
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# MediaTek UART (mt6577-uart via 8250)
CONFIG_SERIAL_8250_MT6577=y

# Simple framebuffer + fbcon for the LK logo/early display
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

#

# UFS (MT6895 UFS host is enabled in the SoC DT)
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# MediaTek USB
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set

# SPMI bus + MT6363/MT6368 PMIC regulators
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# MT6375 PMIC on i2c5 (charger / fuel gauge / ADC)
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_CLASS=y
CONFIG_MT6375_CHARGER=y
CONFIG_MEDIATEK_MT6375_ADC=y

# SouthChip SC8551A 2:1 fast-charge pumps (master on i2c9, slave on i2c7)
CONFIG_SC8551_CHARGER=y
# charge-pump manager bridging TCPM PPS to the SC8551s
CONFIG_PEARL_CP_MANAGER=y

# MT6895 SCP/SPM power domains
CONFIG_MTK_SCPSYS_MT6895=y

# Keep the kernel release pinned to exactly 7.2.0.
# With LOCALVERSION_AUTO=y the release picks up "-g<hash>-dirty" whenever the
# builder can read the git tree - which made module vermagic depend on whether
# the build ran as root (git refuses a repo owned by another user) or as the
# repo owner. The flashed image is plain 7.2.0, so modules built the other way
# are rejected by the version-magic check. Build with LOCALVERSION= as well.
# CONFIG_LOCALVERSION_AUTO is not set

# MediaTek SCP (tinysys) coprocessor: vendor scp/rv driver. The SCP firmware
# is preloaded by the bootloader; the driver reads the loader info from SRAM
# and releases the core, exposing the IPI channels (sensor hub, audio, and the
# HCP channel imgsys needs).
# 第 26 轮：改回内建 (=y)，与 pearl 分支上"实机验证可用"的配置一致
# (arch/arm64/configs/pearl.config 原本就是 =y)。理由：
#  1. pearl 的 SCP 是在开机 probe 阶段起核并报 ready；本树第 22 轮改成 =m 后，
#     运行期 insmod scp.ko 会挂死 AP（看门狗冷复位），挂死点未知。
#  2. scp/rv 源码、DT 节点、SMC id、reserved-memory 我们都已经与 pearl 一致，
#     唯一剩下的差异就是这个 =m/=y，所以这是最该先对齐的一个变量。
#  3. 这一改动同时打通 eccci 的 SCP 胶水：ccci_fsm_scp.c 里
#     CCCI_SCP_DRIVER_BUILTIN 门的定义就是"SCP 也内建"。门开后
#     fsm_scp_init() 才会真正调用 scp_A_register_notify()，从而在 SCP READY
#     事件里执行 fsm_scp_init0() -> mtk_ipi_register(IPI_IN_APCCCI_0)，
#     这正是基带 CCISM-over-SCP 需要的通路（第 25 轮被 #else 分支跳过）。
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_LOGGER_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_DEBUG_SUPPORT=y

# SCP-backed sensor hub: ALS (auto brightness) and accelerometer (rotation).
# The firmware owns the physical sensors; this driver implements the IPI
# control protocol plus shared-memory rings and exposes IIO devices.
CONFIG_MTK_SENSOR_SUPPORT=m
CONFIG_MTK_SENSORHUB=m
CONFIG_IIO=y

# MT6375 Type-C / TCPC mainline port
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y

# Input: haptics, keypad, SPMI PMIC keys, and NT36672E touch over SPI2
CONFIG_INPUT_AW8697=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_MTK_KPD=y
CONFIG_INPUT_MTK_SPMI_KEYS=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_TOUCHSCREEN_NVT_TS_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y

# MediaTek mailbox / rpmsg / CMDQ / mminfra infrastructure
CONFIG_MAILBOX=y
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_MMINFRA=y

# IOMMU/SMI for the display/GPU path
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6895=y

# GPU: Mali-G610 via Panthor + MediaTek GPUEB power handshake
CONFIG_DRM_PANTHOR=y
CONFIG_MTK_GPUEB=y

# Display: downstream mediatek_v2 + MML + pearl panel/backlight
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_LEDS_KTZ8863A=y
CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO=y
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_MTK_MML=y
# mainline MTK MMSYS/CMDQ are not used by the v2 display stack
# CONFIG_MTK_MMSYS is not set
# CONFIG_MTK_CMDQ is not set
# CONFIG_PHY_MTK_MIPI_DSI is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_MI_DISP=y
CONFIG_MI_DISP_DEBUGFS=y
CONFIG_MI_DISP_SYSFS=y
CONFIG_MI_DISP_PROCFS=y
CONFIG_MI_DISP_BRIGTHNESS_CLONE_COOLER=y
CONFIG_MI_DISP_NOTIFIER=y
CONFIG_MI_DISP_LOG=y

# pearl boot marker writer
CONFIG_PEARL_MARKER_WRITER=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Wifi
CONFIG_MTK_COMBO=y
CONFIG_MTK_COMBO_CHIP_CONSYS_6895=y
CONFIG_MTK_COMBO_WIFI=y
CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH=y

# Bluetooth
CONFIG_MTK_BTIF=y
CONFIG_COMMON_CLK_MT6895_PERI_AO=y
CONFIG_MTK_COMBO_BT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_LE=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# Sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT6895=y
CONFIG_SND_SOC_MT6895_MT6368=y
CONFIG_SND_SOC_MT6368=y
CONFIG_SND_SOC_MTK_SMART_PHONE=y
CONFIG_SND_SOC_MTK_SRAM=y
CONFIG_SND_SOC_MTK_SPK_AMP=y
CONFIG_SND_SOC_TFA9874=y
CONFIG_MFD_MT6685=y
CONFIG_MT6685_AUDCLK=y
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_MEDIATEK_SPMI_PMIC_ADC=y
CONFIG_MT635X_EFUSE=y
CONFIG_SND_SOC_MT6368_ACCDET=y

# DRAM
CONFIG_MTK_DRAMC=y
CONFIG_MTK6895_DVFSRC_PIN=y

# Network
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IPV6=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES_COMPAT=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_NETFILTER_XT_MATCH_BPF=y

# Waydroid
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NFT_MASQ=y

# Swap / memory
CONFIG_ZRAM=y
CONFIG_ZSWAP=y

# PSI / FUSE / OverlayFS
CONFIG_PSI=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

# Filesystems
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_BTRFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# pearl: MT6895 CCCI modem and SCP sensorhub bring-up
# CCCI is built into the image: built-in probes at boot, no insmod.
# The data-path HIFs stay out of the image (see eccci/Kconfig).
CONFIG_MTK_CCCI_MAINLINE=y
# CONFIG_MTK_CCCI_MAINLINE_DATAPATH_HIF is not set
CONFIG_COMMON_CLK_MT6895_BUS=y
# --- 第 32 轮：MT6895 LVTS 温度传感器 (pearl 06e3b74860 + f60ab7f98a) ---
# 与 pearl 分支实机验证过的取值一致。校准来自 LK 的 /chosen/atag,devinfo
# （由 nvmem-mtk-devinfo 暴露），不是裸 efuse 窗口（后者在同一偏移返回 0）。
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL_LVTS=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_RESET_CONTROLLER=y

# MediaTek GPS (GNSS) driver —— 第 39 轮接入（模块，后续再改内嵌）
CONFIG_MTK_GPS_SUPPORT=y
CONFIG_MTK_VCP_RPROC=y
CONFIG_VIDEO_MEDIATEK_VCODEC=y
CONFIG_VIDEO_MEDIATEK_VCODEC_VCP=y
CONFIG_VIDEO_MEDIATEK_VCP=y
CONFIG_VIDEO_MEDIATEK_VCP_DEC=y
CONFIG_MTK_VCP_MBOX=y
