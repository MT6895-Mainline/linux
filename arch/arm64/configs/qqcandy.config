# MT6895 oplus "qqcandy" kernel config fragment
# OPPO K10 (project 21143) / OnePlus Ace Racing Edition (project 22801)
# Merge on top of the arm64 defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig \
#       arch/arm64/configs/qqcandy.config
#
# Derived from xaga.config (same SoC baseline); every deviation from it
# carries a reason. M1 scope: basic boot -- PMIC rails over SPMI,
# UFS, USB, charger/ADC, ramoops debug loop.

# --- SoC / pinctrl / clocks -------------------------------------------------
# MT6895 pin controller; all board pinctrl states hang off &pio.
CONFIG_PINCTRL_MT6895=y

# Display/MMSYS/GCE clock providers. Kept from xaga: the mediatek_v2 DRM
# stack needs them even before the panel lands in M2.
CONFIG_COMMON_CLK_MT6895=y
CONFIG_COMMON_CLK_MT6895_MFGCFG=y
CONFIG_COMMON_CLK_MT6895_MMSYS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# Panel/backlight class device needed by the future NT36672C panel driver;
# xaga's KTZ8863A backlight IC and L16 panel are XAGA-only hardware:
# this board drives backlight via DCS 0x51 inside the panel driver
# (SPEC §3), so both symbols stay OFF.
# CONFIG_DRM_PANEL_LEDS_KTZ8863A is not set
# CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO is not set

# MediaTek UART (mt6577-uart via 8250). Nodes are enabled in the DT even
# though LK gates the console off; costs nothing, keeps earlycon possible.
CONFIG_SERIAL_8250_MT6577=y

# Panel console path (no UART on device). simple-framebuffer node itself is
# NOT populated yet (LK fb address unknown for this board until dumped);
# keep the plumbing on so enabling it later is config-only.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# pstore/ramoops: PRIMARY debug channel (no UART). ramoops region
# @0x48090000 size 0xe0000 is hot-reboot verified on this device
# (SPEC §0); DT node lives in mt6895-oplus-qqcandy.dts.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_DMESG=y

# --- SPMI + PMICs ------------------------------------------------------------
# SPMI bus (pmif+spmimst @1c804000) carries MT6363 (slave 4) and
# MT6368 (slave 5) -- same topology as xaga, drivers upstream
# (drivers/spmi/spmi-mtk-pmif.c, regulator/mt636{3,8}-regulator.c).
# Explicitly on because the OSS defconfig never listed them (SPEC §2.1).
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGMAP_SPMI=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
# Richtek RT5133/RT6160: instantiated by the OSS base dts (rt5133.dtsi/
# rt6160.dtsi includes at mt6895.dts:13734-13735) but referenced by NO
# rail on this board (SPEC §5). Drivers kept built-in so the nodes can be
# added without a config round-trip if a dump shows they exist here.
CONFIG_REGULATOR_RT5133=y
CONFIG_REGULATOR_RT6160=y

# Power/home keys polled straight off the MT6363 via spmi-mtk-pmif.
CONFIG_INPUT_MTK_SPMI_KEYS=y
# Volume-down through the MTK keypad controller (kp@1c00e000).
CONFIG_KEYBOARD_MTK_KPD=y

# --- MT6375 (charger / fuel gauge / ADC / TCPC on i2c5 = 11280000, 0x34) ----
# Ground truth: real device charges through MT6375 at that bus/address.
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_CLASS=y
CONFIG_MT6375_CHARGER=y
CONFIG_MEDIATEK_MT6375_ADC=y
CONFIG_MEDIATEK_MT6375_AUXADC=y
CONFIG_MT6375_BATTERY=y

# Type-C / PD via the MT6375 integrated TCPC.
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y

# --- Haptics ------------------------------------------------------------------
# AW8697(/AW86927?) motor on i2c7 @0x5A (DT node added on the correct bus
# for this board; xaga's copy on i2c1 is disabled in the DTS).
CONFIG_INPUT_AW8697=y
CONFIG_INPUT_EVDEV=y

# --- Storage ------------------------------------------------------------------
# UFS host. Kconfig symbol is SCSI_UFS_MEDIATEK (the "UFS_MEDIATEK" name in
# SPEC §7 maps to this); ufshci@112b0000 runs in the minimal LK-powered
# bring-up mode described in mt6895.dtsi:1251-1264.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# Filesystems (Android userdata f2fs; ext4 for expdb/dynamic partitions).
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_VFAT_FS=y

# initramfs boot path (root=/dev/ram style cmdline).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- USB ------------------------------------------------------------------------
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set

# --- CPU frequency ----------------------------------------------------------------
# MT6895 cpufreq-hw with the fixed cpu-supply stubs from mt6895.dtsi.
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# --- GPU / EB handshake --------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_PANTHOR=y
# GPUEB mailbox/IPI framework for Mali-G610 power handshake.
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_GPUEB=y

# Sensor hub running on the stock SCP firmware preloaded by LK.
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
CONFIG_MTK_SENSOR_SUPPORT=y
CONFIG_MTK_SENSORHUB=y

# SCP/SPM power domains (connsys CONN domain among others).
CONFIG_MTK_SCPSYS_MT6895=y

# IOMMU: keep both the legacy mtk_iommu and the downstream-compatible
# MT6895 variant, matching the working mediatek_v2 snapshot.
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6895=y

# --- Display (mediatek_v2 downstream stack) ------------------------------------------
# Keep mainline MTK_MMSYS off (v2 uses its own dispsys_config path).
CONFIG_MTK_MMINFRA=y
# CONFIG_MTK_MMSYS is not set
# DEVIATION from SPEC §7 (+MTK_CMDQ): mainline MTK_CMDQ must stay OFF in
# THIS tree -- mediatek_v2 ships its own cmdq core and enabling both
# collides on duplicate cmdq_* symbols (same decision as xaga.config).
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_DRM_MEDIATEK=y
# M2 再开：mediatek_v2 过不了 gcc16 的全局 -Werror=return-type
# (mtk_disp_gamma.c:496 / mtk_disp_aal.c:2868 kthread 无 return)，修批量随面板移植落地
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK_PANEL=m
CONFIG_MTK_MML=y
# mediatek_v2 has its own mipi-tx PHY driver; the mainline one would probe
# -EBUSY on the same platform driver name.
# CONFIG_PHY_MTK_MIPI_DSI is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# --- Touch bus (kept ready for M2) -----------------------------------------------------
# SPI2 hosts the NT36672C TDDI touch. Bus stays enabled; the xaga
# novatek NVT-ts driver stays off -- this board's TP will run the ported
# vendor oplus_touchscreen_v2 stack (SPEC §4).
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
# CONFIG_TOUCHSCREEN_NVT_TS_SPI is not set
CONFIG_SPI_SPIDEV=y

# --- Connectivity ----------------------------------------------------------------------
# WiFi/BT/GPS: gen4m + conninfra stack comes from the defconfig
# (CONFIG_MTK_COMBO/_CHIP_CONSYS_6895/_WIFI=y there). Kept ON per plan:
# 6.18 already carries conninfra/gen4m and xaga proves the consys nodes
# work; only board-specific DT nodes remain (M3, flavor_bin to verify).
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# --- xaga-only leftovers ------------------------------------------------------------------
# XAGA_MARKER_WRITER mirrors printk into the xaga log_store region at
# 0x7ffbf000 -- an XAGA FDT address with no verification on this board;
# enabling it would scribble into unvalidated DRAM. Must stay off until a
# qqcandy-specific log_store reservation exists.
# CONFIG_XAGA_MARKER_WRITER is not set

# --- M1 boot path -----------------------------------------------------------
# Embed OUR board DTB and override LK's FDT (generic board-dtb.o hook,
# arch/arm64/Kconfig). Without this, LK hands us its Android DT.
CONFIG_MTK_EMBED_BOARD_DTB=y
CONFIG_MTK_EMBED_BOARD_DTB_NAME="mt6895-oplus-qqcandy"

# The previous working .config pointed INITRAMFS_SOURCE at a local scratch dir
# that is not part of this tree; an empty source builds the default empty cpio.
CONFIG_INITRAMFS_SOURCE=""

# 显示链保持开启：点屏(M2)依赖 mediatek_v2 vendor DRM（面板驱动挂 mtk_panel_ext）。
# gcc16 下 vendor 代码的 -Werror=return-type 等问题按报错逐个修复，不绕过。
CONFIG_DRM=y
# msync2 路径触发 gcc16 疑似误报的浮点错误，bring-up 期关闭（见 mtk_drm_crtc.c 注释）
# CONFIG_MTK_CRTC_MSYNC2 is not set

# 调试期必开：printk 镜像进 log_store 环形区(0x7ffbf000)，WDT 重启后 LK 回写
# expdb —— 无 UART 无 console 时的唯一早期日志通道（xaga 同款机制）
CONFIG_XAGA_MARKER_WRITER=y
CONFIG_RTC_DRV_MT6685=y

# NFC: NXP PN544-compatible controller at i2c3 @0x28 (stock SN100T class)
CONFIG_NFC=y
CONFIG_NFC_PN553_DEVICES=y

# --- Networking/runtime parity with xaga.config (fb69b7e/18d9644/55250e7 deltas) --
# Waydroid NAT via nft masquerade + legacy iptables MASQUERADE path
CONFIG_NFT_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
# IPv6 policy routing / advanced routing (IPV6_MULTIPLE_TABLES already on)
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_ROUTE_MULTIPATH=y
# FUSE for Waydroid/content-hub mounts (CONFIG_FUSE_FS in 6.18)
CONFIG_FUSE_FS=y
# =m entries are dead on device (no modules dir); conntrack match is
# required by the Waydroid bridge NAT rules
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# IR transmitter (PWM-based)
CONFIG_MTK_PWM=y
CONFIG_MTK_IRTX_PWM_SUPPORT=y

# Flashlight (aw36515 LED flash IC)
CONFIG_MTK_FLASHLIGHT=y
CONFIG_MTK_FLASHLIGHT_CORE=y
# CONFIG_MTK_VIDEO_AW36515_23081 is not set
CONFIG_MTK_VIDEO_AW36515=y

# LVTS thermal calibration source: the bootloader devinfo table
# (/chosen/atag,devinfo), not the raw efuse window (offsets read back zero there)
CONFIG_NVMEM_MTK_DEVINFO=y

# Hardware JPEG encoder (V4L2 M2M). The device tree node is gated behind the
# mtk_jpeg driver's jpeg_enable parameter until it is verified on hardware.
CONFIG_VIDEO_MEDIATEK_JPEG=y

# V4L2 stateless video decoder (MT6895, driven from the kernel). Must be built
# in: the device has no modules directory, so =m would never load.
CONFIG_VIDEO_MEDIATEK_VCODEC=y

CONFIG_NF_TABLES_INET=y
