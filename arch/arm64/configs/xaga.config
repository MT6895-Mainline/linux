# MT6895 Xiaomi Redmi Note 11T Pro+ (xaga) kernel config fragment
# Merge on top of the arm64 defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig \
#       arch/arm64/configs/xaga.config

# SoC / pinctrl
CONFIG_PINCTRL_MT6895=y

# Display / MMSYS clocks
CONFIG_COMMON_CLK_MT6895=y
CONFIG_COMMON_CLK_MT6895_MFGCFG=y
CONFIG_COMMON_CLK_MT6895_MMSYS=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_LEDS_KTZ8863A=y
CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO=y

# MediaTek UART (mt6577-uart via 8250)
CONFIG_SERIAL_8250_MT6577=y

# Panel console (no UART on device: simple-framebuffer + fbcon)
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

CONFIG_DRM_FBDEV_EMULATION=y

# pstore/ramoops (matches downstream Android 0x48090000 config)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# UFS (kept disabled in DT until clock drivers land)
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# Filesystems (Android userdata is f2fs; ext4 also for expdb/dynamic partitions)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_CHECK_FS=y
CONFIG_VFAT_FS=y

# MediaTek USB
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set

# CPU frequency scaling (MT6895 cpufreq-hw, live DT regs)
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# MT6375 PMIC on i2c5 (charger / fuel gauge / TCPC) -- battery bring-up
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_CLASS=y
CONFIG_MT6375_CHARGER=y
CONFIG_MEDIATEK_MT6375_ADC=y

# MT6375 Type-C / TCPC mainline port
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y

# AW8697 haptic motor on i2c1 (evdev FF, firmware-predefined waveforms)
CONFIG_INPUT_AW8697=y
CONFIG_INPUT_EVDEV=y

# SPMI bus + MT6363 PMIC keys (power/home polled via spmi-mtk-pmif)
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_INPUT_MTK_SPMI_KEYS=y
