>>>>>>> theirs

# MTK keypad controller (volume-down via kp@1c00e000)
CONFIG_KEYBOARD_MTK_KPD=y

# DRM / GPU (Mali-G610 via panthor; stub fixed-regulator for OPP mali-supply)
CONFIG_DRM=y
CONFIG_DRM_PANTHOR=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y


# GPUEB mailbox/IPI framework for Mali-G610 power handshake
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_GPUEB=y

# MT6895 SCP/SPM power domains (needed for consys CONN power domain)
CONFIG_MTK_SCPSYS_MT6895=y

# Match the working mediatek_v2 snapshot: keep both legacy mtk_iommu and the
# downstream-compatible MT6895 IOMMU enabled.
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6895=y

# MediaTek DRM display (downstream mediatek_v2)
# Match the working mediatek_v2 snapshot: do NOT enable mainline MTK_MMSYS;
# the v2 driver uses its own dispsys_config path. Keep mainline MTK_CMDQ
# disabled to avoid duplicate cmdq_* symbols.
CONFIG_MTK_MMINFRA=y
# CONFIG_MTK_MMSYS is not set
# CONFIG_MTK_CMDQ is not set
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_MEDIATEK_PANEL=m
CONFIG_MTK_MML=y
# mediatek_v2 has its own mediatek-mipi-tx driver; disable the mainline PHY
# driver to avoid a duplicate platform driver name (-EBUSY at registration).
# CONFIG_PHY_MTK_MIPI_DSI is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSTORE_DMESG=y

# SPI2 touchscreen bus (NT36672E, spi-mt65xx)
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_TOUCHSCREEN_NVT_TS_SPI=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_REGMAP_SPMI=y
CONFIG_XAGA_MARKER_WRITER=y

# Keep RFKILL=y too: cfg80211 depends on `RFKILL || !RFKILL`, which in
# Kconfig tristate logic becomes =m when RFKILL=m and downgrades both
# CFG80211 and MAC80211 from =y to =m.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# Embed the xaga DTB and override LK's FDT at boot (was hardcoded before the
# board-dtb.o generalization; keeps existing xaga builds unchanged).
CONFIG_MTK_EMBED_BOARD_DTB=y
CONFIG_MTK_EMBED_BOARD_DTB_NAME="mt6895-xiaomi-xaga"
