# Minimal MT6895 Xiaomi Redmi Note 11T Pro+ (xaga) base config fragment
# Merge on top of the arm64 defconfig:
#   scripts/kconfig/merge_config.sh arch/arm64/configs/defconfig \
#       arch/arm64/configs/xaga.config
#
# This fragment intentionally only enables the SoC base pieces added so far.
# Peripheral/display/audio/GPU options will be added in later cleanup stages.

CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT6895=y
CONFIG_COMMON_CLK_MT6895=y

# MediaTek CPUFreq
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# MediaTek UART (mt6577-uart via 8250)
CONFIG_SERIAL_8250_MT6577=y

# Simple framebuffer + fbcon for the LK logo/early display
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

#

# UFS (MT6895 UFS host is enabled in the SoC DT)
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# MediaTek USB
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y
# CONFIG_USB_G_SERIAL is not set

# SPMI bus + MT6363/MT6368 PMIC regulators
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
CONFIG_REGULATOR_MTK_DVFSRC=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# MT6319 external CPU bucks (spmi USID 6/7). Must be built-in: the target
# rootfs has no /lib/modules, so =m would never load. Needed to read/control
# the real VPROC rails (fixed vproc stub gives no visibility).
CONFIG_REGULATOR_MT6315=y

# MT6375 PMIC on i2c5 (charger / fuel gauge / ADC)
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_CLASS=y
CONFIG_MT6375_CHARGER=y
CONFIG_MEDIATEK_MT6375_ADC=y

# SouthChip SC8551A 2:1 fast-charge pumps (master on i2c9, slave on i2c7)
CONFIG_SC8551_CHARGER=y
# SouthChip SC8561 2:1/4:1 fast-charge pumps (xagapro, i2c9@0x64 / i2c7@0x65)
CONFIG_SC8561_CHARGER=y
# charge-pump manager bridging TCPM PPS to the SC8551s
CONFIG_XAGA_CP_MANAGER=y

# MT6895 SCP/SPM power domains
CONFIG_MTK_SCPSYS_MT6895=y

# MediaTek SCP (tinysys) coprocessor: vendor scp/rv driver. The SCP firmware
# is preloaded by the bootloader; the driver reads the loader info from SRAM
# and releases the core, exposing the IPI channels (sensor hub, audio, and the
# HCP channel imgsys needs).
CONFIG_MTK_TINYSYS_SCP_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_LOGGER_SUPPORT=y
CONFIG_MTK_TINYSYS_SCP_DEBUG_SUPPORT=y

# SCP-backed sensor hub: ALS (auto brightness) and accelerometer (rotation).
# The firmware owns the physical sensors; this driver implements the IPI
# control protocol plus shared-memory rings and exposes IIO devices.
CONFIG_MTK_SENSORHUB=y
CONFIG_IIO=y

# MT6375 Type-C / TCPC mainline port
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y

# Input: haptics, keypad, SPMI PMIC keys, and NT36672E touch over SPI2
CONFIG_INPUT_AW8697=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_MTK_KPD=y
CONFIG_INPUT_MTK_SPMI_KEYS=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_TOUCHSCREEN_NVT_TS_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y

# MediaTek mailbox / rpmsg / CMDQ / mminfra infrastructure
CONFIG_MAILBOX=y
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_MMINFRA=y

# IOMMU/SMI for the display/GPU path
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6895=y

# GPU: Mali-G610 via Panthor + MediaTek GPUEB power handshake
CONFIG_DRM_PANTHOR=y
CONFIG_MTK_GPUEB=y

# Display: downstream mediatek_v2 + MML + xaga panel/backlight
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_LEDS_KTZ8863A=y
CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO=y
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_MTK_MML=y
# mainline MTK MMSYS/CMDQ are not used by the v2 display stack
# CONFIG_MTK_MMSYS is not set
# CONFIG_MTK_CMDQ is not set
# CONFIG_PHY_MTK_MIPI_DSI is not set
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_MI_DISP=y
CONFIG_MI_DISP_DEBUGFS=y
CONFIG_MI_DISP_SYSFS=y
CONFIG_MI_DISP_PROCFS=y
CONFIG_MI_DISP_BRIGTHNESS_CLONE_COOLER=y
CONFIG_MI_DISP_NOTIFIER=y
CONFIG_MI_DISP_LOG=y

# xaga boot marker writer
CONFIG_XAGA_MARKER_WRITER=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Wifi
CONFIG_MTK_COMBO=y
CONFIG_MTK_COMBO_CHIP_CONSYS_6895=y
CONFIG_MTK_COMBO_WIFI=y
CONFIG_MTK_CONNSYS_DEDICATED_LOG_PATH=y

# Bluetooth
CONFIG_MTK_BTIF=y
CONFIG_COMMON_CLK_MT6895_PERI_AO=y
CONFIG_MTK_COMBO_BT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_LE=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# Sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT6895=y
CONFIG_SND_SOC_MT6895_MT6368=y
CONFIG_SND_SOC_MT6368=y
CONFIG_SND_SOC_MTK_SMART_PHONE=y
CONFIG_SND_SOC_MTK_SRAM=y
CONFIG_SND_SOC_MTK_SPK_AMP=y
CONFIG_SND_SOC_TFA9874=y
CONFIG_MFD_MT6685=y
CONFIG_MT6685_AUDCLK=y
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_MEDIATEK_SPMI_PMIC_ADC=y
CONFIG_MT635X_EFUSE=y
CONFIG_SND_SOC_MT6368_ACCDET=y

# DRAM
CONFIG_MTK_DRAMC=y
CONFIG_MTK_DVFSRC=y

# Network
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IPV6=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES_COMPAT=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_NETFILTER_XT_MATCH_BPF=y

# Waydroid
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NFT_MASQ=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_INTERFACE=y
CONFIG_INET_AH=y
CONFIG_INET_ESP=y
CONFIG_INET_IPCOMP=y
CONFIG_INET6_AH=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_XFRM_SUB_POLICY=y
CONFIG_XFRM_MIGRATE=y
CONFIG_XFRM_STATISTICS=y

# Swap / memory
CONFIG_ZRAM=y
CONFIG_ZSWAP=y

# PSI / FUSE / OverlayFS
CONFIG_PSI=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

# Filesystems
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_BTRFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# --- pstore/ramoops: capture the previous boot's console across a WDT reset.
# The region (0x48090000, 0xe0000) is reserved in the xaga DTS ramoops node,
# matching the one LK passes via cmdline. Keep RAM built-in so a hang in late
# boot still has a registered backend.
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- DRM panic: render the panic kmsg (or QR) onto the panel via drm_panic.
# mediatek_v2 planes implement get_scanout_buffer/panic_flush (mtk_drm_plane.c).
CONFIG_DRM_PANIC=y
CONFIG_DRM_PANIC_DEBUG=y
CONFIG_FONT_TER16x32=y

# --- Panic screen: QR encoding the compressed kmsg, scannable from a photo.
# Needs the Rust toolchain pinned in build-xaga-work-7.2-lz4.sh (RUST_DIR).
# Use "kmsg" instead of "qr_code" if building without Rust. ---
CONFIG_RUST=y
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y
CONFIG_DRM_PANIC_SCREEN="qr_code"
CONFIG_DRM_PANIC_SCREEN_QR_VERSION=40

# --- Thermal: MT6895 LVTS low-voltage thermal sensors (vendor soc_temp_lvts
# port). Calibration is read from the bootloader devinfo table exposed by
# nvmem-mtk-devinfo, not the raw efuse window. This gives the CPU/GPU/DRAM
# temperature zones under /sys/class/thermal. ---
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL_LVTS=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_RESET_TI_SYSCON=y
CONFIG_RESET_CONTROLLER=y

# --- Platform profiles: fake ACPI platform_profile so power-profiles-daemon
# detects a real driver.  The bridge lives in drivers/misc and maps the
# profile onto the MT6895 cpufreq governor (see xaga-platform-profile.c).
# powersave is a module in the base defconfig; force it built-in so the
# low-power profile works even before modules are available. ---
CONFIG_XAGA_PLATFORM_PROFILE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y

# MT6895 VCP multimedia codec stack: the VCP remoteproc plus the encoder and
# decoder frontends and their V4L2/media dependencies.  The target boots from
# the embedded initramfs with no /lib/modules, so everything is built in.
CONFIG_MEDIA_SUPPORT=y
CONFIG_V4L2_ASYNC=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L2_H264=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_V4L2_VP9=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_MEDIATEK_VCODEC=y
CONFIG_VIDEO_MEDIATEK_VCODEC_VCP=y
CONFIG_VIDEO_MEDIATEK_VCP=y
CONFIG_VIDEO_MEDIATEK_VCP_DEC=y
CONFIG_MTK_VCP_RPROC=y
# The generic vcodec core has "depends on VIDEO_MEDIATEK_VPU || MTK_SCP".
# MT6895 has no VPU, so MTK_SCP must be built in for the codec to be built in
# too rather than an unloadable module; MTK_SCP selects RPMSG_MTK_SCP.
CONFIG_MTK_SCP=y
CONFIG_RPMSG_MTK_SCP=y

# --- Fingerprint: FPC1540/FPC15xx sensor on the hardware SPI3 controller.
# Owns power/reset/IRQ, identifies the part by HWID, captures and decodes the
# native 2-bit noise-shaped readout. See drivers/misc/fpc1540.c. ---
CONFIG_FPC1540=y

CONFIG_INPUT_UINPUT=y

CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_CMA_SIZE_MBYTES=256

# --- MediaTek ISP (camera) stack, ported from downstream ---
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_DW9768=y

# Camera bringup: lets per-file dev_dbg be enabled at runtime via
#   echo 'file dw9768.c +p' > /sys/kernel/debug/dynamic_debug/control
CONFIG_DYNAMIC_DEBUG=y
CONFIG_VIDEO_MTK_ISP_COMMON=y
CONFIG_VIDEO_MTK_ISP_CAMSYS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_VIDEO_MTK_ISP_HCP=y
CONFIG_VIDEO_MTK_ISP_IMGSYS=y
CONFIG_VIDEO_MTK_ISP_IPESYS=y
CONFIG_MTK_V4L2_IMGSENSOR=y
# xaga has 3 rear (64MP S5KGW1 main, 8MP S5K4H7 ultra, 2MP GC02M1 macro) and
# 1 front (16MP OV16A1).  These must match the sensor-names in
# xaga-camera.dtsi, otherwise the imgsensor subdrv is not built and its probe
# fails (subdrv_name_ret -22), leaving the HAL with fewer cameras.
CONFIG_CUSTOM_KERNEL_IMGSENSOR="xagas5kgw1_mipi_raw xagas5k4h7_mipi_raw xagagc02m1_mipi_raw xagaov02b10_mipi_raw xagaov16a1_mipi_raw"
CONFIG_MTK_CCD_REMOTEPROC=y
CONFIG_RPMSG_MTK_CCD=y
CONFIG_REGULATOR_FAN53870=y
CONFIG_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_REGULATOR_RT5133=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_MTK_GED_GE=y

# --- MediaTek interconnect / MMQoS: camera + display DRAM bandwidth votes.
#     The mmqos provider is the vendor interconnect extension, the EMI
#     provider is the standard mainline icc-emi, and the camera/DRM
#     consumers use the mtk-interconnect extension API. ---
CONFIG_INTERCONNECT_MTK=y
CONFIG_INTERCONNECT_MTK_EXTENSION=y
CONFIG_INTERCONNECT_MTK_EMI=y
CONFIG_INTERCONNECT_MTK_MMQOS_COMMON=y
CONFIG_INTERCONNECT_MTK_MMQOS_MT6895=y
CONFIG_MTK_SMI=y

# MTK camera EEPROM / calibration driver (cam_cal): provides /dev/camera_eepromN.
# BUILD_PRODUCT_NAME selects the EEPROM layout set (xaga -> xaga*_mtk_eeprom.c).
CONFIG_MTK_CAM_CAL=y
CONFIG_BUILD_PRODUCT_NAME="xaga"

# DM, needed by Waydroid
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_VERITY=y

# USB configfs
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Android filesystems / metadata ---
# EROFS for read-only system/vendor images. ROM images are built as EROFS
# and mounted through loop; no vendor-specific filesystem driver needed.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# F2FS is optional, but Android's vold/installd expect it to exist for
# f2fs-formatted data/metadata images and for compression experiments.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y

# File-based encryption and fs-verity. Android's vold/installd and APK
# verification paths expect these; they are independent of dm-verity.
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_ENCRYPTED_KEYS=y

# --- SELinux ---
# Android init loads the policy and sets enforcing/permissive.  Keep
# DEVELOP=y so the kernel starts permissive; use androidboot.selinux=...
# to select the initial mode for bring-up.  Do not enable SELinux debug
# logging unless actively debugging policy.
CONFIG_NETWORK_SECMARK=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,selinux,bpf"

# --- Android networking / netd ---
# No modules are built or installed, so promote the pieces netd, tethering,
# IPv6 firewall rules and tc/eBPF bandwidth accounting actually use.
CONFIG_VLAN_8021Q=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_ACT_GACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_SKBEDIT=y
CONFIG_NET_ACT_CSUM=y
CONFIG_NET_CLS_BPF=y
