# MediaTek MT6895 Xiaomi Redmi K50 (rubens) configuration fragment.
# Merge directly on top of arch/arm64/configs/defconfig:
#
#   scripts/kconfig/merge_config.sh -m -O out \
#       out/.config arch/arm64/configs/rubens.config
#   make O=out ARCH=arm64 LLVM=1 olddefconfig
#
# This fragment is self-contained and must not be combined with xaga.config.

# Platform and early console
CONFIG_ARCH_MEDIATEK=y
CONFIG_XIAOMI_RUBENS=y
CONFIG_PINCTRL_MT6895=y
CONFIG_COMMON_CLK_MT6895=y
CONFIG_COMMON_CLK_MT6895_PERI_AO=y
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y
CONFIG_SERIAL_8250_MT6577=y

# Storage available to the early raw bootlog writer
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# MT6895 power, PMIC and power domains
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
# The MT6363/MT6368 SPMI PMIC children (regulators, ADC, keys) are created
# by the MTK SPMI PMIC MFD; without it no regulator ever registers and every
# panel/display supply silently defers.
CONFIG_MFD_MTK_SPMI_PMIC=y
CONFIG_MEDIATEK_SPMI_PMIC_ADC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6363=y
CONFIG_REGULATOR_MT6368=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_MFD_MT6375=y
CONFIG_CHARGER_CLASS=y
CONFIG_MT6375_CHARGER=y
CONFIG_MEDIATEK_MT6375_ADC=y
CONFIG_MTK_SCPSYS_MT6895=y

# Mali-G610 MC6 (Valhall CSF, arch 10.8): mainline panthor driver plus the
# arm/mali/arch10.8/mali_csffw.bin firmware at /lib/firmware.
CONFIG_DRM_PANTHOR=y
CONFIG_MTK_GPUEB=y

# USB: xaga-style OTG MTU3 with the mt6785-tphy driver (the xsphy driver
# does not present the normal device-mode D+ pull-up on this IP).
# g_serial exposes a CDC ACM port (ttyGS0) that userspace runs a shell on.
CONFIG_PHY_MTK_TPHY=y
# CONFIG_PHY_MTK_XSPHY is not set
CONFIG_USB_MTU3=y
# CONFIG_USB_MTU3_GADGET is not set
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_UEVENT=y

# Type-C for the Linux system
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_TCPCI_MT6375=y

# SPI and input base; the Rubens ST FTS driver is a separate milestone
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_MTK_KPD=y
CONFIG_INPUT_MTK_SPMI_KEYS=y
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y
CONFIG_SPI_SPIDEV=y
# CONFIG_TOUCHSCREEN_NVT_TS_SPI is not set
CONFIG_TOUCHSCREEN_RUBENS_FTS_SPI=y
# CONFIG_TOUCHSCREEN_NVT_DEBUG_FS is not set

# MediaTek mailbox, CMDQ, MMINFRA and display IOMMU
CONFIG_MAILBOX=y
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_CMDQ_MBOX_EXT=y
CONFIG_MTK_MMINFRA=y
CONFIG_MTK_IOMMU=y
CONFIG_MTK_IOMMU_MT6895=y

# DRM v2 base used by the future Rubens display port
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_MTK_MML=y
CONFIG_MI_DISP=y
CONFIG_MI_DISP_DEBUGFS=y
CONFIG_MI_DISP_SYSFS=y
CONFIG_MI_DISP_PROCFS=y
CONFIG_MI_DISP_BRIGTHNESS_CLONE_COOLER=y
CONFIG_MI_DISP_NOTIFIER=y
CONFIG_MI_DISP_LOG=y

# Do not pull in xaga's panel, XAGR writer, or incomplete vendor drivers.
# Rubens uses the L11A 38 0A 0A 1440x3200 command-mode DSC panel.
# CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO is not set
CONFIG_DRM_PANEL_L11A_38_0A_0A_DSC_CMD=y
# CONFIG_DRM_PANEL_LEDS_KTZ8863A is not set
# CONFIG_XAGA_MARKER_WRITER is not set
# CONFIG_MTK_BTIF is not set
# CONFIG_SND_SOC_TFA9874 is not set

# Rubens diagnostic persistence
CONFIG_RUBENS_EARLYLOG=y
CONFIG_RUBENS_BOOTLOG=y
CONFIG_PSTORE=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=10240
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=21

# Filesystems commonly needed by a Linux distribution on this device
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y

# Audio: MT6895 AFE + MT6368 codec + TFA9874 speaker amps (DTS inherited
# from the xaga base tree).
CONFIG_SOUND=y
# PMIC (MT6368) efuse, needed by the MT6368 audio codec
CONFIG_MT635X_EFUSE=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT6895=y
CONFIG_SND_SOC_MT6895_MT6368=y
CONFIG_SND_SOC_MT6368=y
CONFIG_SND_SOC_TFA9874=y

# AW8697 haptic (vendored mainline driver, firmware aw8697_haptic.bin).
CONFIG_INPUT_AW8697=y

# Connectivity: downstream MediaTek CONNAC2X2 SOC7_0 stack (Wi-Fi fullmac
# over CONNSYS + Bluetooth over BTIF).  The stack is built-in, so the BT
# and cfg80211 cores must be built-in too for the symbols to link.
CONFIG_BT=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_MTK_BTIF=y
CONFIG_MTK_COMBO=y
