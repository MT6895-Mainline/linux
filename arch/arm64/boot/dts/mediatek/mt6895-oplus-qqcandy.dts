// SPDX-License-Identifier: GPL-2.0 OR MIT
/*
 * MT6895 (MediaTek Dimensity 8100) oplus "qqcandy" board:
 *   OPPO K10 (project 21143) / OnePlus Ace Racing Edition (project 22801).
 * Both projects share the same dtsi set in the OSS tree (only the camera
 * cust dtsi differs); this file is written against that union with 22801
 * as the primary reference.
 *
 * Sources (all values carry a per-line provenance comment):
 *   - OSS overlay: .qqcandy-ref/kernel/arch/arm64/boot/dts/mediatek/
 *       oplus6895_22801.dts (+ oplus6895_21143.dts, near-identical)
 *   - OSS base:    same dir mt6895.dts (~14k lines), PMIC defaults
 *       mt6363.dtsi / mt6368.dtsi
 *   - Porting spec: .qqcandy-ref/PORTING_SPEC.md (cross-checked rev,
 *       187 lines; sections 0/3/5/7 are quoted below as "SPEC §n")
 *   - Host tree baseline: mt6895.dtsi / mt6895-xiaomi-xaga.dts
 *
 * Ground truth of the real device (SPEC §0):
 *   - cmdline: lcm=1-oplus21143_tianma_nt36672c_dsi_vdo_lcm_drv-fps=11976
 *              nf_nt36672c (NT36672C TDDI panel + SPI touch, same die)
 *   - MT6375 charger/gauge on i2c bus @11280000, address 0x34
 *   - rails actually referenced by the board: mt6368_vio28/vmc/vtp,
 *     mt6363_vufs18 (panel IO)
 *   - no UART console (LK disables it): ramoops @0x48090000 size 0xe0000,
 *     hot-reboot verified, is the primary debug channel
 *
 * M1 scope: basic boot. Display/touch/peripherals land in M2-M4 and are
 * kept as commented placeholders with their verified facts.
 */

/dts-v1/;
#include "mt6895.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "OPPO K10 / OnePlus Ace Racing Edition (oplus qqcandy)";
	chassis-type = "handset";
	compatible = "oplus,qqcandy", "mediatek,mt6895";

	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		/*
		 * Pin the i2c aliases so userspace sees the stock bus numbers
		 * (same trick as xaga dts:21-27). Ground truth: mt6375 sits on
		 * the 11280000 controller (= i2c5 here) at 0x34; the AW8697
		 * haptic sits on 11d04000 (= i2c7) at 0x5A (22801:352).
		 */
		i2c1 = &i2c1;
		i2c5 = &i2c5;
		i2c7 = &i2c7;
	};

	chosen: chosen {
		/*
		 * qqcandy: this board always boots from UFS. The 5.10 UFS
		 * driver reads atag,boot from /chosen to set boot_device
		 * (struct tag_bootmode: size, tag, bootmode, boottype).
		 * boottype=2 means BOOTDEV_UFS.
		 */
		atag,boot = <0 0 0 2>;
		/*
		 * Style kept from the stock overlays (bootargs_ext,
		 * oplus6895_22801.dts:23-28: console=tty0 root=/dev/ram
		 * loglevel=8 initcall_debug=1 -- there is NO UART console).
		 * clk_ignore_unused: clocks are LK-managed / stubbed in this
		 * tree (mt6895.dtsi:222-244 comments), same reason xaga keeps
		 * it. printk.devkmsg + log_buf_len=2M: keep verbose early logs
		 * for the ramoops channel (xaga dts:30-43 rationale).
		 */
		bootargs = "console=tty0 root=/dev/ram loglevel=8 initcall_debug=1 clk_ignore_unused printk.devkmsg=on log_buf_len=2M";
		/*
		 * Hardware UART console (bring-up): OPPO routes a debug uart
		 * through the Type-C SBU pins behind mtk_printk_ctrl
		 * .disable_uart (=0 injected in setup.c). stdout-path gives us
		 * earlycon + preferred console on 11002000; setup.c appends
		 * console=ttyS0 as well so late console lands there too.
		 */
		stdout-path = "serial0:115200n8";

		/*
		 * atag,videolfb (M2): raw struct tag_videolfb bytes
		 * (mtk_drm_fbdev.h: u64 fb_base, u32 islcmfound,
		 * u32 fps x100, u32 vram, char lcmname[]). Values are the
		 * same live LK dumps the simplefb node was written from:
		 * fb_base=0xfe1af000, vram=0x1e50000 (full triple buffer,
		 * matches mblock-xx reservation), fps=11976 (~120Hz),
		 * islcmfound=1, panel NT36672C. Vendor DRM's fbdev then
		 * adopts LK's scanout buffer (mtk_drm_fb_gem_insert)
		 * instead of allocating a fresh one, so the console stays
		 * on the surface LK hardware keeps scanning out.
		 */
		atag,videolfb = [00 f0 1a fe 00 00 00 00
				 01 00 00 00
				 88 2e 00 00
				 00 00 e5 01
				 4e 54 33 36 36 37 32 43 00];
	};

	/* USB gadget 3.3V rail (mtu3 requires vusb33-supply; LK powers it).
	 * Same stub as xaga dts:62-68. */
	vusb33: regulator-vusb33 {
		compatible = "regulator-fixed";
		regulator-name = "vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	memory {
		device_type = "memory";
		/*
		 * Verified against the live device's LK FDT dump: single
		 * 8 GiB bank @0x40000000 (mblock_info confirms the same
		 * layout). LK still fixes this up per boot, so it also
		 * tolerates other RAM configs of the same family.
		 */
		reg = <0x0 0x40000000 0x2 0x0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * pstore/ramoops -- the ONLY verified reservation for this
		 * board (SPEC §0: hot-reboot proven @0x48090000, size
		 * 0xe0000). Split mirrors the xaga pattern (xaga dts:336-344)
		 * which matches downstream Android configs.
		 */
		ramoops@48090000 {
			compatible = "ramoops";
			reg = <0x00 0x48090000 0x00 0xe0000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x10000>;
			ecc-size = <0>;
			no-map;
		};

		/*
		 * The remaining mblock reservations are transplanted verbatim
		 * from the live device's LK FDT dump (qqcandy-mblock.dtsi,
		 * 44 regions / ~609 MiB incl. TEE/GZ/BL31/SCP/modem/ADSP/APU/
		 * consys/framebuffer). mblock-10-pstore is omitted there --
		 * the ramoops@48090000 node above covers that exact range.
		 */
#include "qqcandy-mblock.dtsi"
	};

	/*
	 * M2 placeholder -- display bring-up facts (do not lose):
	 *
	 * Panel: Tianma NT36672C TDDI VDO LCD.
	 * compatible = "oplus21143,tianma,nt36672c,vdo"
	 *   (5.10 drivers/gpu/drm/panel/oplus21143_tianma_nt36672c_dsi_vdo.c,
	 *   registered via mipi_dsi_driver_register :2672; probe does an
	 *   of_graph remote self-check against dsi_out and returns -ENODEV
	 *   if not itself -> dual-panel coexistence selection :2528-2543).
	 * Wiring (22801 overlay :840-858): reset-gpios = pio41,
	 * bias-gpios = pio120/pio119 (AVDD/AVEE emulated as GPIOs, NOT
	 * LDOs; vmcldo/vmchldo supplies were commented out upstream),
	 * DSI_TE = pio40 (pinctrl mode_te_te, 21143:699-703).
	 * Supply: vufsldo-supply = <&mt6363_vufs18> (22801:850; rail added
	 * under &mt6363 below).
	 * Backlight: no backlight IC -- DCS 0x51 three-byte direct write
	 * (:1783-1797); 12-bit HW max 4095, normal ceiling
	 * MAX_NORMAL_BRIGHTNESS = 3276; 7 multi-FPS ext_params
	 * (120/90/60/50/48/45/30 Hz, data_rate=1100, 120Hz clock=373794,
	 * :1028-1060); single jdi_panel_init() inline DCS sequence (:458);
	 * ESD check reads 0x0A expecting 0x9C; lane_swap table :1099-1104
	 * must be preserved in the M2 port.
	 *
	 * The xaga panel stub below (dsi0/panel@1, defined inside
	 * mt6895.dtsi:2203-2216 with the l16 DSC panel + vrf18_reg stub) is
	 * disabled here; its DRM_PANEL_L16 driver is also switched off in
	 * qqcandy.config. The M2 panel node goes in its place, wired to
	 * dsi_out via of_graph.
	 */

	/*
	 * M2 placeholder -- touchscreen facts:
	 * NT36672C TDDI touch, same die as the panel, on SPI2:
	 * &spi2 { touchscreen@0 { compatible = "oplus,tp_noflash"; ... } }
	 * (22801:498-556): 9.6 MHz, chip-name="NF_NT36672C","ILI7807S",
	 * reset-gpio = pio212, irq = pio135, CS within pins
	 * SPI2_A_MI/CSB/MO/CLK = pio109/110/111/112 (:611-616),
	 * touchpanel,tx-rx-num = <18 36>, display-coords 1080x2412.
	 * Firmware: factory FW is EMBEDDED as firmware-data-0 arrays in
	 * oplus-21143-tp.dtsi (8711 lines); firmware_name="0xAA348NT00" is
	 * a directory name, not a .img. Driver plan (SPEC §4): vendor v2
	 * framework port; note mainline nt36xxx.c is an SPI driver
	 * ("novatek,NVT-ts-spi") whose mem_map already covers this chip ID.
	 * spi2 stays disabled until then (its dtsi child novatek@0 is the
	 * xaga NT36672E touch and must not bind).
	 */
	/*
	 * Connectivity (M3 pulled forward -- conninfra probe sets g_hw_init_done,
	 * without this node its init spins forever spamming fbcon).
	 * Nodes copied from xaga dts:356-400 (downstream mt6895.dts origin);
	 * memory-region labels added on our mblock regions. TODO(M3):
	 * flavor_bin / ANTSEL pinctrl must be re-derived for qqcandy antenna
	 * config, not cloned (SPEC R3); connfem node deferred to M3.
	 */
	consys: consys@18000000 {
		compatible = "mediatek,mt6895-consys";
		#thermal-sensor-cells = <0>;
		reg = <0x00 0x10001000 0x00 0xee4 0x00 0x10005000 0x00 0xa78
		       0x00 0x11c30000 0x00 0xa14 0x00 0x11ea0000 0x00 0xa04
		       0x00 0x18000000 0x00 0x470 0x00 0x18001000 0x00 0x658
		       0x00 0x18003000 0x00 0x204 0x00 0x1800e000 0x00 0x124
		       0x00 0x18011000 0x00 0x138 0x00 0x18012000 0x00 0x98
		       0x00 0x18020000 0x00 0x4c 0x00 0x18023000 0x00 0xe28
		       0x00 0x1803b000 0x00 0x18 0x00 0x18040000 0x00 0x2c
		       0x00 0x18041000 0x00 0x128 0x00 0x18042000 0x00 0x324
		       0x00 0x1804b000 0x00 0x414 0x00 0x1804d000 0x00 0x41c
		       0x00 0x1804f000 0x00 0x148 0x00 0x18053800 0x00 0x1000
		       0x00 0x18060000 0x00 0xc08 0x00 0x18070000 0x00 0x8004
		       0x00 0x1c001000 0x00 0xfb0 0x00 0x1c007000 0x00 0x51c>;
		power-domains = <&spm MT6895_POWER_DOMAIN_CONN>;
		mt6363_vcn13-supply = <&mt6363_vcn13>;
		mt6363_vrfio18-supply = <&mt6363_vrfio18>;
		mt6368_vcn33_1-supply = <&mt6368_vcn33_1>;
		mt6368_vcn33_2-supply = <&mt6368_vcn33_2>;
		mt6368_vant18-supply = <&mt6368_vant18>;
		memory-region = <&consys_reserved>;
		emi-addr = <0>;
		emi-size = <0x7e0000>;
		emi-alignment = <0x100000>;
		emi-max-addr = <0x90000000>;
		tcxo_support = "false";
		scp-shm-addr = <0>;
		scp-shm-size = <0x20000>;
		status = "okay";
	};

	wifi: wifi@18000000 {
		compatible = "mediatek,wifi";
		reg = <0x0 0x18000000 0x0 0x700000>;
		interrupts = <GIC_SPI 522 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 537 IRQ_TYPE_LEVEL_HIGH 0>;
		memory-region = <&wifi_reserved>;
		flavor_bin = "b"; /* qqcandy vendor firmware only ships 1b/1c; use 1b */
		emi-addr = <0>;
		emi-size = <0x1400000>;
		emi-alignment = <0x1000000>;
		emi-max-addr = <0xC0000000>;
		/*
		 * Factory MAC of this unit, read at runtime from the partition the
		 * vendor stack keeps it in -- no address is hardcoded here. The chip
		 * firmware reports an address of its own in the NIC capability
		 * event (fc:d9:08:8a:9d:91 on this board, not what is on the box);
		 * downstream nvram_daemon overrides it from
		 * /nvdata/APCFG/APRDEB/WIFI, which is mirrored at a fixed offset in
		 * proinfo. See the proinfo_nvmem node.
		 */
		nvmem-cells = <&wifi_mac>;
		nvmem-cell-names = "mac-address";
		status = "okay";
	};

	/*
	 * Per-unit data that the bootloader does not patch into DT. proinfo has
	 * no filesystem, so the addresses sit at fixed offsets and can be read
	 * as plain nvmem cells:
	 *
	 *   0x68  6 bytes  Bluetooth BD_ADDR   (2c:a7:ef:46:96:d6 on this unit)
	 *   0x6e  6 bytes  WiFi MAC            (…d7, one more than the BD_ADDR)
	 *
	 * Both are byte-for-byte copies of /nvdata/APCFG/APRDEB/{BT_Addr,WIFI+4},
	 * which is what the vendor userspace daemon reads.
	 */
	proinfo_nvmem: nvmem {
		compatible = "mediatek,partition-nvmem";
		partition-label = "proinfo";
		#address-cells = <1>;
		#size-cells = <1>;

		bt_bdaddr: bd-address@68 {
			reg = <0x68 6>;
		};

		wifi_mac: mac-address@6e {
			reg = <0x6e 6>;
		};
	};

	connfem: connfem@18000000 {
		compatible = "mediatek,mt6895-connfem";
		pinctrl-names = "wlan7207h_wlan7207c",
				"wlan7207h_wlan7205c",
				"qm42195_qm45197";
		pinctrl-0 = <&wlan7207h_wf0>, <&wlan7207h_wf1>,
			    <&wlan7207c_wf0>, <&wlan7207c_wf1>;
		pinctrl-1 = <&wlan7207h_wf0>, <&wlan7207h_wf1>,
			    <&wlan7205c_wf0>, <&wlan7205c_wf1>;
		pinctrl-2 = <&qm42195_wf0>, <&qm42195_wf1>,
			    <&qm45197_wf0>, <&qm45197_wf1>;
		status = "okay";

		epa_elna_mtk {
			parts = <&nofem &nofem>,
				<&wlan7207h &wlan7207c>,
				<&wlan7207h &wlan7207c>,
				<&wlan7207h &wlan7207c>,
				<&wlan7207h &wlan7207c>,
				<&wlan7207h &wlan7205c>,
				<&wlan7207h &wlan7205c>,
				<&wlan7207h &wlan7205c>,
				<&wlan7207h &wlan7205c>,
				<&qm42195 &qm45197>,
				<&qm42195 &qm45197>,
				<&qm42195 &qm45197>,
				<&qm42195 &qm45197>;

			bt {
				flags-12 { epa_elna; };
				flags-11 { bypass; };
				flags-10 { epa_elna; };
				flags-9 { bypass; };
				flags-8 { epa_elna; };
				flags-7 { bypass; };
				flags-6 { epa_elna; };
				flags-5 { bypass; };
				flags-4 { epa_elna; };
				flags-3 { bypass; };
				flags-2 { epa_elna; };
				flags-1 { bypass; };
			};

			wifi {
				flags-10 { open-loop; };
				flags-9 { open-loop; };
				flags-6 { open-loop; };
				flags-5 { open-loop; };
				flags-2 { open-loop; };
				flags-1 { open-loop; };
			};
		};

		nofem: nofem {
			vid = <0>;
			pid = <0>;
		};

		wlan7207h: wlan7207h {
			vid = <2>;
			pid = <4>;
		};

		wlan7205c: wlan7205c {
			vid = <2>;
			pid = <5>;
		};

		wlan7207c: wlan7207c {
			vid = <2>;
			pid = <7>;
		};

		qm42195: qm42195 {
			vid = <3>;
			pid = <1>;
		};

		qm45197: qm45197 {
			vid = <3>;
			pid = <2>;
		};
	};

	/*
	 * simple-framebuffer over the LK scanout layer: fbcon on screen before
	 * the real DRM panel driver lands (M2), the xaga console trick for
	 * UART-less devices. Address/size from live atag,videolfb
	 * (fb_base=0xfe1af000, vramSize=0x1e50000); 1080x2412 NT36672C panel,
	 * stride follows the family's 1088-pixel alignment. Region is no-map
	 * via qqcandy-mblock.dtsi.
	 */
	simplefb@fe1af000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xfe1af000 0x0 0xa3f000>;
		width = <1080>;
		height = <2412>;
		stride = <(1088 * 4)>;
		format = "a8r8g8b8";

		display-timing {
			width-mm = <76>;
			height-mm = <168>;
		};
	};

	/*
	 * Volume-down key. Unlike the volume-up/power pair (MT6363 PMIC, see
	 * &mt6363keys) this button is not wired to the SoC KPD row/col matrix
	 * at all: stock routes it through a plain GPIO EINT. Official dtbo
	 * fragment@72/73/74 (dtbo.img entry 0):
	 *   kpd_volume_down { compatible = "mediatek, VOLUME_DOWN-eint";
	 *                     interrupt-parent = <&pio>;
	 *                     interrupts = <0x7f 0x02 0x7f 0x00>; }
	 *   keypad,volume-down = <&pio>, <0x7f 0x00>;
	 *   volume_down@0 { pins_cmd_dat { pinmux = <0x7f00>; input-enable; } }
	 * i.e. GPIO127 (0x7f) in func0, input, active-low. Confirmed on the
	 * live device: sampling the GPIO127 input bit every 6 ms gives clean
	 * 1->0->1 transitions matching each physical press, while KP_MEM1..5
	 * stay 0xffff and the mtk-kpd IRQ count stays 0.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&volume_down_pins>;

		key-volume-down {
			label = "Volume Down";
			gpios = <&pio 127 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <32>;
		};
	};

	sound {
		compatible = "mediatek,mt6895-mt6368-sound";
		mediatek,platform = <&afe>;
		mediatek,headset-codec = <&mt6368codec>;
		mediatek,spk-i2s = <3 9>;

		mediatek,speaker-codec {
			sound-dai = <&speaker_amp_l>, <&speaker_amp_r>;
		};
	};
};

/*
 * UARTs kept alive even though LK gates the serial console off (SPEC §0);
 * nodes cost nothing and give earlycon a path if a debug cable ever lands.
 * RX/TX only on purpose: UCTS0/URTS0 would mux GPIO119/120 which this
 * board uses as the panel AVDD/AVEE bias GPIOs (22801:846-849).
 * Pin functions: mt6895-pinfunc.h:570/578 (URXD0/UTXD0 = gpio88/89),
 * :587/596 (URXD1/UTXD1 = gpio90/91).
 */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

&pio {
	uart0_pins: uart0-pins {
		pins_rx_tx {
			pinmux = <PINMUX_GPIO88__FUNC_URXD0>,
				 <PINMUX_GPIO89__FUNC_UTXD0>;
			bias-pull-up;
		};
	};

	uart1_pins: uart1-pins {
		pins_rx_tx {
			pinmux = <PINMUX_GPIO90__FUNC_URXD1>,
				 <PINMUX_GPIO91__FUNC_UTXD1>;
			bias-pull-up;
		};
	};

	/*
	 * DSI_TE: panel TE pin (stock 22801 "mode_te_te" state, 22801:701-703),
	 * muxed when the panel device binds; plain GPIO bias only for
	 * reset(41)/AVDD(120)/AVEE(119), no pinctrl needed for those.
	 */
	dsi_te_pins: dsi-te-pins {
		pins_te {
			pinmux = <PINMUX_GPIO40__FUNC_DSI_TE>;
		};
	};

	/*
	 * Volume-down EINT pad: func0 + input, pull-up. Matches the stock
	 * "volume_down_as_int" state (official dtbo fragment@74) and the
	 * pad state LK already leaves behind (ies=1, pullen=1, pullup=1).
	 */
	volume_down_pins: volume-down-pins {
		pins_key {
			pinmux = <PINMUX_GPIO127__FUNC_GPIO127>;
			input-enable;
			bias-pull-up;
		};
	};

	/* LCD LED backlight enable (5.10 oplus6895_21143.dts:705-714) */
	lcm_led_en_pins: lcm-led-en-pins {
		pins_led_en {
			pinmux = <PINMUX_GPIO215__FUNC_GPIO215>;
			slew-rate = <1>;
			output-high;
		};
	};
};

/*
 * PMIC keys: align long-press behaviour with the OSS default
 * (long-press-mode=<2>, power-off-time-sec=<1>, mt6363.dtsi:107-120)
 * instead of the xaga values baked into mt6895.dtsi.
 */
&mt6363keys {
	mediatek,long-press-mode = <2>;
	power-off-time-sec = <1>;
};

/*
 * ------------------------------------------------------------------
 * MT6363 (main PMIC, SPMI slave 4) - full rail set.
 * Baseline: mt6895.dtsi already defines VBUCK2/VBUCK4/VCN13/VRFIO18;
 * those four stay untouched (the 5.10 board overlays never override
 * them). Every rail below is added verbatim from the OSS defaults with
 * its source line, plus the base-dts always-on overrides
 * (mt6895.dts:13744-13795).
 * ------------------------------------------------------------------
 */
&mt6363 {
	regulators {
		/* mt6363.dtsi:123-131 */
		mt6363_vs2: VS2 {
			regulator-compatible = "VS2";
			regulator-name = "mt6363_vs2";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1600000>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
			regulator-always-on;
		};

		/* mt6363.dtsi:132-139 + always-on mt6895.dts:13744 */
		mt6363_vbuck1: VBUCK1 {
			regulator-compatible = "VBUCK1";
			regulator-name = "mt6363_vbuck1";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
			regulator-always-on;
		};

		/* mt6363.dtsi:148-155 */
		mt6363_vbuck3: VBUCK3 {
			regulator-compatible = "VBUCK3";
			regulator-name = "mt6363_vbuck3";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <200>;
			regulator-allowed-modes = <0 1 2>;
		};

