/*
 * ------------------------------------------------------------------
 * MT6368 (secondary PMIC, SPMI slave 5) - full rail set.
 * Baseline: mt6895.dtsi defines VBUCK2/VCN33_1/VCN33_2/VANT18; those
 * stay untouched. Board-overlay overrides applied where present:
 * vio28 -> 3.0 V (22801:39-42), vmc -> 1.8 V boot-on (22801:640-645),
 * vtp -> 3.0 V boot-on (22801:646-651). These three plus vfp are the
 * rails the real device actually exercises (SPEC §0/§5).
 * ------------------------------------------------------------------
 */
&mt6368 {
	regulators {
		/* mt6368.dtsi:111-118 */
		mt6368_vbuck1: VBUCK1 {
			regulator-compatible = "VBUCK1";
			regulator-name = "mt6368_vbuck1";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <200>;
			regulator-allowed-modes = <0 1 2>;
		};

		/* mt6368.dtsi:127-134 */
		mt6368_vbuck3: VBUCK3 {
			regulator-compatible = "VBUCK3";
			regulator-name = "mt6368_vbuck3";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
		};

		/* mt6368.dtsi:135-142 */
		mt6368_vbuck4: VBUCK4 {
			regulator-compatible = "VBUCK4";
			regulator-name = "mt6368_vbuck4";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
		};

		/* mt6368.dtsi:143-150 + always-on mt6895.dts:13800 */
		mt6368_vbuck5: VBUCK5 {
			regulator-compatible = "VBUCK5";
			regulator-name = "mt6368_vbuck5";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
			regulator-always-on;
		};

		/* mt6368.dtsi:151-158 + always-on mt6895.dts:13804 */
		mt6368_vbuck6: VBUCK6 {
			regulator-compatible = "VBUCK6";
			regulator-name = "mt6368_vbuck6";
			regulator-min-microvolt = <300000>;
			regulator-max-microvolt = <1193750>;
			regulator-enable-ramp-delay = <180>;
			regulator-allowed-modes = <0 1 2>;
			regulator-always-on;
		};

		/* mt6368.dtsi:159-167; USB 3.3 supply ref mt6895.dts:9568 */
		mt6368_vusb: VUSB {
			regulator-compatible = "VUSB";
			regulator-name = "mt6368_vusb";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
			regulator-always-on;
		};

		/* mt6368.dtsi:168-175 + always-on mt6895.dts:13808 */
		mt6368_vaux18: VAUX18 {
			regulator-compatible = "VAUX18";
			regulator-name = "mt6368_vaux18";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-enable-ramp-delay = <240>;
			regulator-allowed-modes = <0 2>;
			regulator-always-on;
		};

		/* mt6368.dtsi:176-183 */
		mt6368_vrf13_aif: VRF13_AIF {
			regulator-compatible = "VRF13_AIF";
			regulator-name = "mt6368_vrf13_aif";
			regulator-min-microvolt = <600000>;
			regulator-max-microvolt = <2100000>;
			regulator-enable-ramp-delay = <200>;
			regulator-allowed-modes = <0 2>;
		};

		/* mt6368.dtsi:184-191 */
		mt6368_vrf18_aif: VRF18_AIF {
			regulator-compatible = "VRF18_AIF";
			regulator-name = "mt6368_vrf18_aif";
			regulator-min-microvolt = <600000>;
			regulator-max-microvolt = <2100000>;
			regulator-enable-ramp-delay = <200>;
			regulator-allowed-modes = <0 2>;
		};

		/* mt6368.dtsi:200-207; vib-supply ref mt6895.dts:2821 */
		mt6368_vibr: VIBR {
			regulator-compatible = "VIBR";
			regulator-name = "mt6368_vibr";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/*
		 * mt6368.dtsi:208-216 (default always-on kept) + BOARD
		 * OVERRIDE min/max = 3.0 V, oplus6895_22801.dts:39-42
		 * (identical in 21143:39-42). Verified in use by the device.
		 */
		mt6368_vio28: VIO28 {
			regulator-compatible = "VIO28";
			regulator-name = "mt6368_vio28";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
			regulator-always-on;
		};

		/* mt6368.dtsi:217-224; fingerprint dvdd 3.3 V request
		 * (22801:1124-1125 dvdd-config 3300000) fits the range. */
		mt6368_vfp: VFP {
			regulator-compatible = "VFP";
			regulator-name = "mt6368_vfp";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/*
		 * mt6368.dtsi:225-232 + BOARD OVERRIDE 3.0 V boot-on,
		 * oplus6895_22801.dts:646-651 (touch panel supply).
		 */
		mt6368_vtp: VTP {
			regulator-compatible = "VTP";
			regulator-name = "mt6368_vtp";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
			regulator-boot-on;
		};

		/* mt6368.dtsi:233-240 */
		mt6368_vmch: VMCH {
			regulator-compatible = "VMCH";
			regulator-name = "mt6368_vmch";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/*
		 * mt6368.dtsi:241-248 + BOARD OVERRIDE 1.8 V boot-on,
		 * oplus6895_22801.dts:640-645.
		 */
		mt6368_vmc: VMC {
			regulator-compatible = "VMC";
			regulator-name = "mt6368_vmc";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
			regulator-boot-on;
		};

		/* mt6368.dtsi:249-256 */
		mt6368_vaud18: VAUD18 {
			regulator-compatible = "VAUD18";
			regulator-name = "mt6368_vaud18";
			regulator-min-microvolt = <600000>;
			regulator-max-microvolt = <2100000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/* mt6368.dtsi:273-280 */
		mt6368_vefuse: VEFUSE {
			regulator-compatible = "VEFUSE";
			regulator-name = "mt6368_vefuse";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/* mt6368.dtsi:281-288 */
		mt6368_vmch_eint_high: VMCH_EINT_HIGH {
			regulator-compatible = "VMCH_EINT_HIGH";
			regulator-name = "mt6368_vmch_eint_high";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};

		/* mt6368.dtsi:289-296 */
		mt6368_vmch_eint_low: VMCH_EINT_LOW {
			regulator-compatible = "VMCH_EINT_LOW";
			regulator-name = "mt6368_vmch_eint_low";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <3500000>;
			regulator-enable-ramp-delay = <680>;
			regulator-allowed-modes = <0 2>;
		};
	};
};

/*
 * ------------------------------------------------------------------
 * I2C layout aligned to the real device (ground truth SPEC §0/§6).
 * ------------------------------------------------------------------
 */

/*
 * i2c1 (11d00000): on qqcandy this bus hosts the SC8547 charge-pump
 * master @0x6F (oplus_charge_21143.dtsi:339) -- M4, voocphy lives in the
 * vendor-modules repo. The AW8697 node inherited from mt6895.dtsi belongs
 * to XAGA (wrong bus AND wrong reset pin: GPIO117 is I2S0_DI on this
 * board, 22801:266-273) -> disabled.
 */
&i2c1 {
	aw8697@5a {
		status = "disabled";
	};
};

/*
 * i2c7 (11d04000): hosts the AW8697(/AW86927?) haptic on qqcandy
 * (22801:352-357: reg 0x5A, reset pio24, irq pio11). The bq28z610 fuel
 * gauge inherited from mt6895.dtsi is xaga-only hardware (qqcandy gauges
 * through the MT6375 FGM, SPEC §1 "无 bq27541") -> disabled; with it gone
 * the bus can run 1 MHz as stock does (22801:349).
 */
&i2c7 {
	clock-frequency = <1000000>;

	fuel-gauge@55 {
		status = "disabled";
	};

	haptic@5a {
		compatible = "awinic,aw8697";
		/*
		 * Waveform/driver-strength parameters from the stock DT, by way
		 * of the xaga port (same AW8697 silicon and the same RAM blob).
		 * Without vib_effect_id_boundary the driver leaves
		 * effect_id_boundary at 0, so it never advertises FF_PERIODIC
		 * and the FF_RUMBLE loop path aims at effect 0 instead of the
		 * continuous sine waveform.
		 */
		aw8697_vib_mode = <0>;
		aw8697_vib_bst_vol_ram = <0x0e>;
		aw8697_vib_bst_vol_rtp = <0x0e>;
		aw8697_vib_bst_vol_default = <0x0e>;
		aw8697_vib_bstdbg = <0x30 0xeb 0xd4 0x00 0x00 0x00>;
		aw8697_vib_r_spare = <0x68>;
		aw8697_vib_tset = <0x1a>;
		aw8697_vib_f0_coeff = <0x104>;
		aw8697_vib_f0_pre = <0x6a4>;
		aw8697_vib_f0_cali_percen = <0x07>;
		aw8697_vib_cont_drv_lev = <0x3c>;
		aw8697_vib_cont_drv_lvl_ov = <0x3c>;
		aw8697_vib_cont_td = <0xef>;
		aw8697_vib_cont_zc_thr = <0x8f8>;
		aw8697_vib_cont_num_brk = <0x03>;
		aw8697_vib_bemf_config = <0x00 0x08 0x03 0xf8>;
		aw8697_vib_f0_trace_parameter = <0x09 0x03 0x01 0x1f>;
		vib_effect_id_boundary = <0x0a>;
		vib_effect_max = <0xc5>;
		/* OSS uses "awinic,aw8697_haptic" (OSS aw8697.c:10358);
		 * the 6.18 driver (drivers/input/misc/aw8697.c:1583) binds
		 * "awinic,aw8697" -- DTS follows the mainline string
		 * (SPEC §6 notes the alias situation). */
		reg = <0x5a>;
		reset-gpios = <&pio 24 GPIO_ACTIVE_HIGH>; /* 22801:356 */
		status = "okay";
		/* IRQ wiring is pio11 (22801:357) but the 6.18 driver never
		 * requests it; left out rather than claiming an unverified
		 * trigger type. TODO(M3): tune waveform params from the
		 * stock DT (qcom,device_id=815 hints AW86927 silicon). */
	};
};

/*
 * ------------------------------------------------------------------
 * Display / touch stubs inherited from mt6895.dtsi -- disabled until
 * M2 replaces them (facts kept in the placeholder comments above).
 * ------------------------------------------------------------------
 */

/*
 * dsi0/panel@1 is the xaga L16 DSC panel stub defined INSIDE
 * mt6895.dtsi (dsi0@14017000). No L16 driver is built for this board,
 * but disable the node anyway so nothing can ever bind it by accident;
 * the qqcandy NT36672C panel node below takes its place.
 */
&dsi0 {
	panel@1 {
		status = "disabled";
		/* Drop the stub's endpoint so no stale graph link to
		 * dsi_out survives (it would trip a graph_endpoint
		 * "not bidirectional" warning against our panel). */
		/delete-node/ port;
	};

	/*
	 * Tianma NT36672C VDO TDDI panel (qqcandy, 22801:840-858):
	 * reset = pio41, AVDD = pio120 (bias index 0), AVEE = pio119
	 * (bias index 1) -- GPIO-driven, not regulators; vufsldo rail
	 * (mt6363_vufs18) is the panel IO supply. reg = <3> mirrors the
	 * stock DSI virtual channel for this panel. The endpoint pair
	 * closes the of_graph loop the panel driver's probe self-check
	 * requires (dsi_out must point back at this node, 5.10 :2528-2543).
	 */
	panel@3 {
		compatible = "oplus21143,tianma,nt36672c,vdo";
		reg = <3>;
		reset-gpios = <&pio 41 GPIO_ACTIVE_HIGH>;
		leden-gpios = <&pio 215 GPIO_ACTIVE_HIGH>; /* LCD LED backlight enable */
		backlight = <&backlight>;
		bias-gpios = <&pio 120 GPIO_ACTIVE_HIGH>,
			     <&pio 119 GPIO_ACTIVE_HIGH>;
		vufsldo-supply = <&mt6363_vufs18>;
		pinctrl-names = "default", "led_en";
		pinctrl-0 = <&dsi_te_pins>;
		pinctrl-1 = <&lcm_led_en_pins>;

		port {
			panel_in_tianma: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	/*
	 * Re-point the DSI host endpoint (defined in mt6895.dtsi with
	 * remote-endpoint = <&panel_ep>) at our panel; the xaga stub's
	 * panel_ep stays parked on the disabled panel@1 node.
	 */
	port {
		dsi_out: endpoint {
			remote-endpoint = <&panel_in_tianma>;
		};
	};
};

/*
 * spi2 carries the xaga NT36672E touch child (novatek@0) in mt6895.dtsi.
 * This board's TP is the NT36672C TDDI touch running the vendor oplus
 * framework -- keep the bus off (and its pinmux untouched) until the M2
 * touchscreen node replaces it; see the M2 placeholder comment above
 * for the verified wiring (cs pio110 / irq pio135 / reset pio212).
 */
&spi2 {
	status = "disabled";
};

/*
 * ------------------------------------------------------------------
 * Storage / USB
 * ------------------------------------------------------------------
 */

/*
 * UFS (ufshci@112b0000, "mediatek,mt8183-ufshci") is enabled by
 * mt6895.dtsi:1251-1264 in minimal form: clocks/regulators/resets are
 * deliberately omitted and treated as optional because LK leaves UFS
 * clocked and powered. Stock wires vcc=vemc / vccq=vufs12 /
 * vccq2=vufs18 (mt6895.dts:5400-5402); leave the supplies unmanaged
 * for M1 (same reasoning as the dtsi comment), revisit in M3 once the
 * clock/reset plumbing exists.
 */


/* qqcandy backlight class shim; put it under soc so it gets a platform dev */
&soc {
backlight: backlight {
compatible = "mediatek,lcd-backlight";
label = "lcd-backlight";
led_mode = <4>;
pwm_config = <0 0 0 0 0>;
max-brightness = <4095>;
max-hw-brightness = <4095>;
};
};

&ufshci {
/* M3: 接上原厂 5.10 的 UFS 电源轨，vcc=vemc / vccq=vufs12 / vccq2=vufs18 */
vcc-supply = <&mt6363_vemc>;
vccq-supply = <&mt6363_vufs12>;
vccq2-supply = <&mt6363_vufs18>;
};

/*
 * USB: same wiring style as xaga dts:504-546. dr_mode=otg with manual
 * role switch (no reliable Type-C attach detection yet); device default
 * so gadget/adbd-style workflows work. The port endpoint closes the
 * graph demanded by the tcpc connector child inside mt6895.dtsi
 * (typec_con_hs <-> mtu3_hs_role_sw).
 */
&ssusb {
	status = "okay";
	dr_mode = "otg";
	maximum-speed = "high-speed";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
	vusb33-supply = <&vusb33>;
	/* MT6375 charger OTG boost: mtu3 enables it when the role
	 * switch flips to host so OTG devices get VBUS (xaga parity). */
	vbus-supply = <&otg_vbus>;

	port {
		mtu3_hs_role_sw: endpoint {
			remote-endpoint = <&typec_con_hs>;
		};
	};
};

&usb_host {
	status = "okay";
	role-switch-default-mode = "peripheral";
	vusb33-supply = <&vusb33>;
};

&usbphy {
	status = "okay";
};

/*
 * Bring-up: watchdog node stays ENABLED - CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED
 * makes the watchdog core feed any HW-running watchdog until userspace
 * opens it. Fighting it (setup.c one-shot + periodic kills, v33-v35)
 * did not stop the ~37 s resets, so feed instead.
 */
&watchdog {
	status = "okay";
};

/*
 * Bring-up: no GPU/GPUEB. expdb shows every silent reset is a
 * 'watch dog timeout' whose wdt_isr dumps GPU/GPUEB state - the
 * GPUEB handshake never completes on this port and a safety WDT in
 * the SPM domain bites ~37 s after boot. Panel scanout (M2) does not
 * need the GPU; re-enable when GPU bring-up starts.
 */
&gpu {
	status = "okay";
};

&gpueb {
	status = "okay";
	gpueb_mem_addr = <0x0 0x7b900000>;
	gpueb_mem_size = <0x0 0x200000>;
};

&u2port {
	status = "okay";
	/* TODO(M2/M3): eye-vrt/eye-term/discth tuning is board analog
	 * data (xaga carries its own values at xaga dts:542-545); get the
	 * qqcandy set from the stock DT before enabling HS stress
	 * workloads. Defaults (untuned) are fine for basic enumeration. */
};

