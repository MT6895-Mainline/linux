};

/*
 * ------------------------------------------------------------------
 * Deferred peripherals (comment-only, keep the verified facts):
 *
 * NFC SN100(T), M3: nxp,pn544 @ i2c3 0x28, irq=pio143 ven=pio4
 *   dnld=pio144 clkreq=pio194, eSE nxp,p61 @spi1
 *   (nfc/mt6895_qqcandy_21143_sn100.dtsi:20-38); driver = small port of
 *   OSS drivers/nfc/pn553-i2c/pn553.c (creates /dev/nq-nci, matches the
 *   running device).
 * SC8547 dual charge pumps, M4: master i2c1@0x6F
 *   (oplus_charge_21143.dtsi:339), slave i2c0@0x6F (:580); voocphy
 *   driver only exists in the vendor-modules repo.
 * Audio TFA9874 stereo PA, M4: i2c6 (11281000) 0x34/0x35, resets
 *   pio157/158 (22801:326-344); needs the mt6895 ASoC platform first.
 * LCD-bias i2c9 node I2C_LCD_BIAS@3e (22801:809-814) NOT carried over:
 *   the NT36672C backlight path is pure DCS 0x51, this node is unused
 *   for it (SPEC §3.1).
 * msdc/SD: stock leaves mmc1 status="disabled" (cust_mt6895_msdc.dtsi:12)
 *   and the 6.18 mt6895.dtsi has no msdc nodes at all -> nothing to do.
 * WiFi/BT/GPS consys nodes (xaga dts:357-481 style): M3 reuse -- copy
 *   from xaga after checking flavor_bin (b_t vs this board) and keeping
 *   THIS board's own connfem ANTSEL mapping (RF design differs; do not
 *   clone xaga's pin mappings blindly). Drivers/configs stay enabled in
 *   qqcandy.config meanwhile.
 * ------------------------------------------------------------------
 */

/* TFA9874 smart amplifiers (Goodix), I2S3 data */
&i2c6 {
	speaker_amp_l: speaker_amp@34 {
		compatible = "goodix,tfa9874";
		reg = <0x34>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left";
		reset-gpio = <&pio 157 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	speaker_amp_r: speaker_amp@35 {
		compatible = "goodix,tfa9874";
		reg = <0x35>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right";
		reset-gpio = <&pio 158 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&afe {
	pinctrl-names = "aud_clk_mosi_off",
			"aud_clk_mosi_on",
			"aud_dat_mosi_off",
			"aud_dat_mosi_on",
			"aud_dat_mosi_ch34_off",
			"aud_dat_mosi_ch34_on",
			"aud_dat_miso0_off",
			"aud_dat_miso0_on",
			"aud_dat_miso1_off",
			"aud_dat_miso1_on",
			"aud_dat_miso2_off",
			"aud_dat_miso2_on",
			"vow_dat_miso_off",
			"vow_dat_miso_on",
			"vow_clk_miso_off",
			"vow_clk_miso_on",
			"aud_gpio_i2s3_off",
			"aud_gpio_i2s3_on",
			"aud_gpio_i2s0_off",
			"aud_gpio_i2s0_on",
			"mtkaif_ul_off",
			"mtkaif_ul_on",
			"mtkaif_dl_off",
			"mtkaif_dl_on";
	pinctrl-0 = <&aud_clk_mosi_off>;
	pinctrl-1 = <&aud_clk_mosi_on>;
	pinctrl-2 = <&aud_dat_mosi_off>;
	pinctrl-3 = <&aud_dat_mosi_on>;
	pinctrl-4 = <&aud_dat_mosi_ch34_off>;
	pinctrl-5 = <&aud_dat_mosi_ch34_on>;
	pinctrl-6 = <&aud_dat_miso0_off>;
	pinctrl-7 = <&aud_dat_miso0_on>;
	pinctrl-8 = <&aud_dat_miso1_off>;
	pinctrl-9 = <&aud_dat_miso1_on>;
	pinctrl-10 = <&aud_dat_miso2_off>;
	pinctrl-11 = <&aud_dat_miso2_on>;
	pinctrl-12 = <&vow_dat_miso_off>;
	pinctrl-13 = <&vow_dat_miso_on>;
	pinctrl-14 = <&vow_clk_miso_off>;
	pinctrl-15 = <&vow_clk_miso_on>;
	pinctrl-16 = <&aud_gpio_i2s3_off>;
	pinctrl-17 = <&aud_gpio_i2s3_on>;
	pinctrl-18 = <&aud_gpio_i2s0_off>;
	pinctrl-19 = <&aud_gpio_i2s0_on>;
	pinctrl-20 = <&mtkaif_ul_off>;
	pinctrl-21 = <&mtkaif_ul_on>;
	pinctrl-22 = <&mtkaif_dl_off>;
	pinctrl-23 = <&mtkaif_dl_on>;
	status = "okay";
};

/* qqcandy LCD backlight bias: 5.10 oplus6895_21143.dts:808-814 */
&i2c9 {
	i2c_lcd_bias@3e {
		compatible = "mediatek,I2C_LCD_BIAS";
		reg = <0x3e>;
		status = "okay";
	};
};

/*
 * Bluetooth reads its factory address from the same partition as WiFi. btmtk
 * registers the HCI device during probe, long before storage is up, so it seeds
 * a locally-administered address, retries this cell until it can be read, and
 * re-applies it (plus the vendor set-address command) once the stack is up --
 * HCI init otherwise overwrites hdev->bdaddr with the controller's built-in one.
 */
&bt {
	nvmem-cells = <&bt_bdaddr>;
	nvmem-cell-names = "bd-address";
};

&mt6375_auxadc {
	isink_load-supply = <&mt6363_isink_load>;
	status = "okay";
};

#include "mt6895-oplus-qqcandy-battery.dtsi"


/* ------------------------------------------------------------------
 * Flashlight: aw36515 dual-LED flash/torch at i2c6 0x63.
 * Node shape and pin (GPIO122, pinctrl pinmux 0x7a00 with slew-rate and
 * output-high/low) come from the device's own firmware DT; the IC shares
 * i2c6 with the TFA9874 amps. The flashlight-core platform node only
 * provides the class/char device - the IC registers itself with it.
 * ------------------------------------------------------------------ */
&soc {
	flashlight_core: flashlight-core {
		compatible = "mediatek,flashlight_core";
	};

	/*
	 * Minimal mddriver anchor (values from the official mt6895.dts).
	 * Only the power-domains link matters today: the ccci_ccif module's
	 * probe takes the MD MTCMOS reference (genpd "md" is unclaimed on
	 * our boots, unlike official ones where LK leaves it on) so that
	 * CCIF registers become accessible. The official ccci,modem_info_v2
	 * property is deliberately absent: LK passes it via the LKINFO
	 * stash and the diagnostics prefer the stash anyway.
	 */
	ccci_md0: mddriver {
		compatible = "mediatek,mddriver";
		mediatek,mdhif_type = <6>;	/* bit1 CCIF | bit2 DPMAIF */
		mediatek,md_id = <0>;
		mediatek,ap_plat_info = <6895>;
		mediatek,md_generation = <6298>;
		reg = <0 0x0d124000 0 0x2000>;	/* MD L2 SRAM */
		power-domains = <&spm MT6895_POWER_DOMAIN_MD>;
	};
};

&pio {
	flash_default: flash-default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO122__FUNC_GPIO122>;
			slew-rate = <1>;
		};
	};

	flash_hwen_high: flash-hwen-high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO122__FUNC_GPIO122>;
			slew-rate = <1>;
			output-high;
		};
	};

	flash_hwen_low: flash-hwen-low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO122__FUNC_GPIO122>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;

	aw36515: aw36515@63 {
		compatible = "mediatek,aw36515";
		reg = <0x63>;
		/* the driver walks the flash@N children and reads their reg */
		#address-cells = <1>;
		#size-cells = <0>;
		#cooling-cells = <2>;
		pinctrl-names = "default", "hwen_high", "hwen_low";
		pinctrl-0 = <&flash_default>;
		pinctrl-1 = <&flash_hwen_high>;
		pinctrl-2 = <&flash_hwen_low>;
		status = "okay";

		flash@0 {
			reg = <0>;
			type = <0>;
			ct = <0>;
			part = <0>;
		};

		flash@1 {
			reg = <1>;
			type = <0>;
			ct = <1>;
			part = <0>;
		};
	};
};
