		};

	

				scp: scp@1c700000 {
			compatible = "mediatek,scp";
			status = "okay";
			reg = <0x1c400000 0x180000>, /* tcm */
			      <0x1c724000 0x1000>, /* cfg */
			      <0x1c721000 0x1000>, /* clk */
			      <0x1c730000 0x1000>, /* cfg core0 */
			      <0x1c740000 0x1000>, /* cfg core1 */
			      <0x1c752000 0x1000>, /* bus tracker */
			      <0x1c760000 0x40000>, /* llc */
			      <0x1c7a5000 0x4>, /* cfg_sec */
			      <0x1c7fb000 0x100>, /* mbox0 base */
			      <0x1c7fb100 0x4>, /* mbox0 set */
			      <0x1c7fb10c 0x4>, /* mbox0 clr */
			      <0x1c7a5020 0x4>, /* mbox0 init */
			      <0x1c7fc000 0x100>, /* mbox1 base */
			      <0x1c7fc100 0x4>, /* mbox1 set */
			      <0x1c7fc10c 0x4>, /* mbox1 clr */
			      <0x1c7a5024 0x4>, /* mbox1 init */
			      <0x1c7fd000 0x100>, /* mbox2 base */
			      <0x1c7fd100 0x4>, /* mbox2 set */
			      <0x1c7fd10c 0x4>, /* mbox2 clr */
			      <0x1c7a5028 0x4>, /* mbox2 init */
			      <0x1c7fe000 0x100>, /* mbox3 base */
			      <0x1c7fe100 0x4>, /* mbox3 set */
			      <0x1c7fe10c 0x4>, /* mbox3 clr */
			      <0x1c7a502c 0x4>, /* mbox3 init */
			      <0x1c7ff000 0x100>, /* mbox4 base */
			      <0x1c7ff100 0x4>, /* mbox4 set */
			      <0x1c7ff10c 0x4>, /* mbox4 clr */
			      <0x1c7a5030 0x4>; /* mbox4 init */

			reg-names = "scp_sram_base",
				    "scp_cfgreg",
				    "scp_clkreg",
				    "scp_cfgreg_core0",
				    "scp_cfgreg_core1",
				    "scp_bus_tracker",
				    "scp_l1creg",
				    "scp_cfgreg_sec",
				    "mbox0_base",
				    "mbox0_set",
				    "mbox0_clr",
				    "mbox0_init",
				    "mbox1_base",
				    "mbox1_set",
				    "mbox1_clr",
				    "mbox1_init",
				    "mbox2_base",
				    "mbox2_set",
				    "mbox2_clr",
				    "mbox2_init",
				    "mbox3_base",
				    "mbox3_set",
				    "mbox3_clr",
				    "mbox3_init",
				    "mbox4_base",
				    "mbox4_set",
				    "mbox4_clr",
				    "mbox4_init";

			interrupts = <GIC_SPI 618 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 619 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 620 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 621 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 622 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 623 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 624 IRQ_TYPE_LEVEL_HIGH 0>;

			interrupt-names = "ipc0",
					  "ipc1",
					  "mbox0",
					  "mbox1",
					  "mbox2",
					  "mbox3",
					  "mbox4";

			core_0 = "enable";
			scp_hwvoter = "enable";
			scp_sramSize = <0x00180000>;
			core_nums = <1>;	/* core number */
			twohart = <1>;		/* two hart arch */
			mbox_count = <5>;
			/* id, mbox, send_size */
			send_table =
			< 0 0  9>,/* IPI_OUT_AUDIO_VOW_1 */
			<14 0  1>,/* IPI_OUT_DVFS_SET_FREQ_1 */
			<15 0  2>,/* IPI_OUT_C_SLEEP_1 */
			<16 0  1>,/* IPI_OUT_TEST_1 */
			<17 1  6>,/* IPI_OUT_LOGGER_CTRL */
			<18 1  2>,/* IPI_OUT_SCPCTL_1 */
			< 4 2  1>,/* IPI_OUT_DVFS_SET_FREQ_0 */
			< 5 2  2>,/* IPI_OUT_C_SLEEP_0 */
			< 6 2  1>,/* IPI_OUT_TEST_0 */
			<33 2  16>,/* IPI_OUT_SCP_CONNSYS */
			< 3 3  2>,/* IPI_OUT_APCCCI_0 */
			<26 3  9>,/* IPI_OUT_AUDIO_ULTRA_SND_0 */
			<35 3  2>,/* IPI_OUT_C_SCP_HWVOTER_DEBUG */
			<29 4 16>,/* IPI_OUT_SENSOR_CTRL */
			<31 4  7>,
			<39 4  10>;/* IPI_OUT_ELLIPTIC_ULTRA_0 *//* IPI_OUT_SENSOR_NOTIFY */

			/* id, mbox, recv_size, recv_opt */
			recv_table =
			< 1 0  2 0>,/* IPI_IN_AUDIO_VOW_ACK_1 */
			< 2 0 26 0>,/* IPI_IN_AUDIO_VOW_1 */
			<36 0  1 0>,/* IPI_IN_AUDIO_ACDDET_1 */
			<15 0  1 1>,/* IPI_OUT_C_SLEEP_1 */
			<20 1 10 0>,/* IPI_IN_SCP_ERROR_INFO_1 */
			<21 1  6 0>,/* IPI_IN_LOGGER_CTRL */
			<22 1  1 0>,/* IPI_IN_SCP_READY_1 */
			< 5 2  1 1>,/* IPI_OUT_C_SLEEP_0 */
			< 8 2 10 0>,/* IPI_IN_SCP_ERROR_INFO_0 */
			< 9 2  1 0>,/* PEARL-r150: IPI_IN_SCP_READY_0 (SCP 就绪通知，缺它 scp_ready 永远 0) */
			<34 2 16 0>,/* IPI_IN_SCP_CONNSYS */
			< 7 3  2 0>,/* IPI_IN_APCCCI_0 */
			<28 3  5 0>,/* IPI_IN_AUDIO_ULTRA_SND_0 */
			<27 3  2 0>,/* IPI_IN_AUDIO_ULTRA_SND_ACK_0 */
			<35 3  4 1>,/* IPI_OUT_C_SCP_HWVOTER_DEBUG */
			<30 4  2 0>,/* IPI_IN_SENSOR_CTRL */
			<32 4  7 0>,
			<40 4  10 0>;

			/* r154: legacy/wrapper IPI 表。缺它 scp_ipi_table_init() 提前
			 * return true，legacy 接收 pin（in_id_0/in_id_1）不注册，
			 * SCP->AP 的消息永远到不了 scp_legacy_handler（PEARL-SCPRX 为空）。
			 * 6 个字段: out_id_0 out_id_1 in_id_0 in_id_1 out_size in_size
			 * 值取自 vendor mt6895.dts: 11/24 = MPOOL out, 12 = MPOOL in, 6 = size */
			legacy_table = <11 24 12 12 6 6>;/* IPI_IN_ELLIPTIC_ULTRA_0 *//* IPI_IN_SENSOR_NOTIFY */

			/* feature, frequecy, coreid */
			scp_feature_tbl = < 0  40 0>,	/* vow */
					  < 1 350 0>,	/* sensor */
					  < 2  26 0>,	/* flp */
					  < 3   0 0>,	/* rtos */
					  < 4 200 1>,	/* speaker */
					  < 5   0 0>,	/* vcore */
					  < 6 135 0>,	/* barge in */
					  < 7  10 0>,	/* vow dump */
					  < 8  80 0>,	/* vow vendor M */
					  < 9  43 0>,	/* vow vendor A */
					  <10  22 0>,	/* vow vendor G */
					  <11  20 0>,	/* vow dual mic */
					  <12 100 0>,	/* vow dual mic barge in */
					  <13 200 0>;	/* ultrasound */	/* ultrasound */

			debug_timeout_reset = "enable"; /* 第26轮：照抄 pearl；SCP ready 超时放宽 10 倍 */
			secure_dump = "enable";
			secure_dump_size = <0x300000>;

			scp_mem_key = "mediatek,reserve-memory-scp_share";

			/* feature ID, size, alignment */
			scp_mem_tbl = < 0 0x0      0x0>, /* secure dump */
				      < 1 0xca700  0x0>, /* vow */
				      < 2 0x100000 0x0>, /* sensor main */
				      < 3 0x180000 0x0>, /* logger */
				      < 4 0x19000  0x0>, /* audio */
				      < 5 0xa000   0x0>, /* vow bargein */
				      < 7 0x19000  0x0>, /* ultrasound */
				      < 8 0x10000  0x0>, /* sensor supper */
				      < 9 0x1000   0x0>, /* sensor list */
				      <10 0x2000   0x0>, /* sensor debug */
				      <11 0x100    0x0>, /* sensor custom writer */
				      <12 0x100    0x0>, /* sensor custom reader */
				      <13 0x8000   0x0>; /* elliptic ultrasound */ /* sensor debug kit 13 */

			memorydump = <0x180000>, /* l2tcm */
				     <0x03c000>, /* l1c */
				     <0x003c00>, /* regdump */
				     <0x000400>, /* trace buffer */
				     <0x100000>; /* dram */
		};

		scp_clk_ctrl: scp_clk_ctrl@1c721000 {
			compatible = "mediatek,scp_clk_ctrl", "syscon";
			reg = <0x1c721000 0x1000>; /* clk */
		};

		scp_gpio: scp_gpio@10005000 {
			compatible = "mediatek,scp_gpio", "syscon";
			reg = <0x10005000 0x1000>;
		};

		scp_infra: scp_infra@10001000 {
			compatible = "mediatek,scpinfra";
			reg = <0x10001000 0x1000>,	/* infracfg_ao */
			      <0x10006000 0x1000>,	/* spm */
			      <0x10000000 0x1000>;	/* topckgen */
			#clock-cells = <1>;
		};

		scp_dvfs {
			compatible = "mediatek,scp_dvfs";
			clocks = <&vlp_cksys CLK_VLP_CK_SCP_SEL>,
				 <&topckgen CLK_TOP_TCK_26M_MX9>;
			clock-names = "clk_mux", "clk_pll_0";

			scp-cores = <1>;
			vlp-support;
			vlpck-support;

			dvfs-opp =
			< 750000	750000	0xff		0xfff		175  0	0x0>,
			< 750000	750000	0xff		0xfff		233  0	0x0>,
			< 750000	750000	0xff		0xfff		350  0	0x0>,
			< 750000	750000	0xff		0xfff		700  0	0x0>;

			gpio-base = <&scp_gpio>;
			gpio-vreq = <0x480 0x7 20>; /* SCP_VREQ_VAO */
			gpio-vreq-mode = <1>;

			do-ulposc-cali;
			fmeter_clksys = <&vlp_cksys>;
			ulposc_clksys = <&vlp_cksys>;
			scp_clk_ctrl = <&scp_clk_ctrl>;
			scp-clk-hw-ver = "v1";
			ulposc-cali-ver = "v2";
			ulposc-cali-num = <1>;
			ulposc-cali-target = <700>;
			ulposc-cali-config =
				<0x071292c0	0x2400	0xc>;
			clk-dbg-ver = "v2";
		};


		pericfg_ccif: pericfg@10003000 {
			compatible = "mediatek,pericfg", "syscon";
			reg = <0x10003000 0x1000>;
		};

		dpmaif: dpmaif@10014000 {
			compatible = "mediatek,dpmaif";
			reg = <0x10014000 0x1000>,
			      <0x1022d000 0x1000>,
			      <0x1022c000 0x1000>,
			      <0x1022e000 0x1000>;
			interrupts = <GIC_SPI 256 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 760 IRQ_TYPE_LEVEL_HIGH 0>;
			mediatek,dpmaif_ver = <3>;
			mediatek,dpmaif_cap = <0x00000004>;
			clocks = <&infracfg_ao 11>,
				 <&infracfg_ao 5>,
				 <&infracfg_ao 13>;
			clock-names = "infra-dpmaif-clk",
				      "infra-dpmaif-blk-clk",
				      "infra-dpmaif-rg-mmw-clk";
		};

		ccifdriver: ccifdriver@10209000 {
			compatible = "mediatek,ccci_ccif";
			reg = <0x10209000 0x1000>,
			      <0x1020a000 0x1000>;
			mediatek,sram_size = <512>;
			ccif-pericfg = <&pericfg_ccif>;
			/* DTS/GIC_ID: CCIF0 241/273; CCIF0 242/274 */
			interrupts = <GIC_SPI 241 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&infracfg_ao 3>,
				 <&infracfg_ao 4>,
				 <&infracfg_ao 1>,
				 <&infracfg_ao 2>,
				 <&infracfg_ao 12>,
				 <&infracfg_ao 7>;
			clock-names = "infra-ccif-ap", "infra-ccif-md",
				      "infra-ccif1-ap", "infra-ccif1-md",
				      "infra-ccif4-md", "infra-ccif5-md";
		};
};






	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW 0>;
		clock-frequency = <13000000>;
	};

	/* 第32轮：LVTS 固定 26 MHz 参考时钟（照抄 pearl）。
	 * 真实的 CLK_IFRAO_THERM 门在这块板上读回是 gated，但寄存器访问照常，
	 * 所以一个 fixed-clock 就够。 */
	clk_lvts_main: clock-lvts-main {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	/* 第32轮：LK 传下来的 efuse shadow 表（/chosen/atag,devinfo）。
	 * MT6895 上这才是 LVTS 校准的权威来源。 */
	devinfo {
		compatible = "mediatek,devinfo";
		#address-cells = <1>;
		#size-cells = <1>;

		lvts_e_data1: data1 { reg = <0x1d4 0xc>; };
		lvts_e_data2: data2 { reg = <0x2f8 0x50>; };
		lvts_e_data3: data3 { reg = <0x2d4 0x14>; };
	};

	/* 第32轮：MT6895 LVTS —— 两个寄存器域，AP @0x10315000、MCU @0x10316000。
	 * 26 个 zone 的 id 与 pearl 完全一致（温度点布局由 SoC 决定，不是板级）。 */
	lvts: lvts@10315000 {
		compatible = "mediatek,mt6895-lvts";
		#thermal-sensor-cells = <1>;
		reg = <0 0x10315000 0 0x1000>,
		      <0 0x10316000 0 0x1000>;
		interrupts = <GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&clk_lvts_main>;
		clock-names = "lvts_clk";
		resets = <&infracfg_rst 0>, <&infracfg_rst 1>;
		nvmem-cells = <&lvts_e_data1>, <&lvts_e_data2>, <&lvts_e_data3>;
		nvmem-cell-names = "e_data1", "e_data2", "e_data3";
	};

	thermal_zones: thermal-zones {
		soc_max {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&lvts 0>;
			trips {
				soc_max_crit: soc_max_crit@0 {
					temperature = <116852>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
		cpu_little1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 1>; };
		cpu_little2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 2>; };
		cpu_little3 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 3>; };
		cpu_little4 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 4>; };
		cpu_big1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 5>; };
		cpu_big2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 6>; };
		cpu_big3 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 7>; };
		cpu_big4 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 8>; };
		cpu_big5 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 9>; };
		cpu_bigbig1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 10>; };
		cpu_big6 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 11>; };
		cpu_bigbig2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 12>; };
		gpu1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 13>; };
		gpu2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 14>; };
		apu1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 15>; };
		apu2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 16>; };
		dram_ch2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 17>; };
		dram_ch0 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 18>; };
		soc_top { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 19>; };
		dram_ch3 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 20>; };
		dram_ch1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 21>; };
		soc_mm { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 22>; };
		md1 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 23>; };
		md2 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 24>; };
		md3 { polling-delay = <0>; polling-delay-passive = <0>; thermal-sensors = <&lvts 25>; };
	};
};

/* NT36672C touch pinctrl (ported from downstream pearl-mt6895-touch.dtsi) */
&pio {
	ts_int_active: ts-int-active {
		pins_int {
			pinmux = <PINMUX_GPIO135__FUNC_GPIO135>;
			input-enable;
			bias-disable;
		};
	};

	ts_int_suspend: ts-int-suspend {
		pins_int {
			pinmux = <PINMUX_GPIO135__FUNC_GPIO135>;
			output-low;
		};
	};

	ts_cs_active: ts-cs-active {
		pins_cs {
			pinmux = <PINMUX_GPIO110__FUNC_SPI2_A_CSB>;
		};
	};

	ts_cs_suspend: ts-cs-suspend {
		pins_cs {
			pinmux = <PINMUX_GPIO110__FUNC_GPIO110>;
			output-low;
			bias-pull-down;
		};
	};

	ts_spi_mode: ts-spi-mode {
		pins_spi {
			pinmux = <PINMUX_GPIO109__FUNC_SPI2_A_MI>,
				 <PINMUX_GPIO110__FUNC_SPI2_A_CSB>,
				 <PINMUX_GPIO111__FUNC_SPI2_A_MO>,
				 <PINMUX_GPIO112__FUNC_SPI2_A_CLK>;
			drive-strength = <2>;
		};
	};
};

/*
 * Mainline port: MTK HCP (imgsys <-> userspace daemon message channel).
 * The daemon (libimgsys_daemon.so startRED) opens /dev/mtk_hcp; the driver
 * reserves the isp71 mblocks and relays GCE packets.
 */
&soc {
	hcp: hcp@0 {
		compatible = "mediatek,hcp";
		iommus = <&mdp_iommu M4U_LARB15_PORT0>;
	};
};

/*
 * Mainline port: imgsys (DIP) SMI sub-commons, LARBs and the imgsys_fw
 * node, adapted from the downstream MT6895 DT.
 *
 * Mainline adaptations:
 *  - soc@0 uses single-cell addresses/sizes, so reg is <0xADDR 0xSIZE>.
 *  - &spm replaces the downstream &scpsys power-domain controller.
 *  - &gce replaces the downstream &gce_m; the downstream &gce_m_sec
 *    mailboxes do not exist on mainline and are dropped.
 *  - &disp_iommu is the mainline display IOMMU (same port macros).
 *  - Only the &imgsys_main_clk clock provider exists on mainline.  The
 *    downstream dip_top_dip1/dip_nr_dip1/wpe1_dip1/wpe2_dip1/wpe3_dip1/
 *    ipesys clock providers are not yet described in the mainline DT, so
 *    only the &imgsys_main_clk clock entries are kept and clock-names is
 *    trimmed to match.
 *  - dma-ranges is dropped (single address cell).
 *  - operating-points-v2 and interconnects/interconnect-names are restored:
 *    opp_table_img/opp_table_ipe are provided above and the mmqos provider
 *    exists, so imgsys MMDVFS and its per-port QoS votes now work.
 *  - dvfsrc-vmm-supply is left out so consumers get a dummy regulator
 *    (the verified-stable configuration; see the seninf note below).
 */
&soc {
	smi_img_subcommon0: smi_img_sub_comm0@15002000 {
		compatible = "mediatek,mt6895-smi-common",
			     "mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
		reg = <0x15002000 0x1000>;
		mediatek,smi = <&smi_common>;
		mediatek,common-id = <15>;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_MAIN>;
		clocks = <&imgsys_main_clk CLK_IMG_LARB9>,
			 <&imgsys_main_clk CLK_IMG_DIP0_DUMMY>,
			 <&imgsys_main_clk CLK_IMG_WPE0_DUMMY>,
			 <&imgsys_main_clk CLK_IMG_WPE2_DUMMY>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	smi_img_subcommon1: smi_img_sub_comm1@15003000 {
		compatible = "mediatek,mt6895-smi-common",
			     "mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
		reg = <0x15003000 0x1000>;
		mediatek,smi = <&smi_mdp_comm>;
		mediatek,common-id = <16>;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_MAIN>;
		clocks = <&imgsys_main_clk CLK_IMG_DIP0_DUMMY>,
			 <&imgsys_main_clk CLK_IMG_IPE_DUMMY>,
			 <&imgsys_main_clk CLK_IMG_WPE1_DUMMY>,
			 <&imgsys_main_clk CLK_IMG_ADL_LARB>;
		clock-names = "apb", "smi", "gals0", "gals1";
	};

	smi_larb9: smi_larb9@15001000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15001000 0x1000>;
		mediatek,larb-id = <9>;
		mediatek,smi = <&smi_img_subcommon0>;
		mediatek,comm-port-id = <0>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_MAIN>;
		clocks = <&imgsys_main_clk CLK_IMG_LARB9>,
			 <&imgsys_main_clk CLK_IMG_LARB9>;
		clock-names = "apb", "smi";
	};

	smi_larb18: smi_larb18@15004000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15004000 0x1000>;
		mediatek,larb-id = <18>;
		mediatek,smi = <&smi_img_subcommon1 &smi_sysram_subcommon2>;
		mediatek,comm-port-id = <3>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_MAIN>;
		clocks = <&imgsys_main_clk CLK_IMG_ADL_LARB>,
			 <&imgsys_main_clk CLK_IMG_ADL_LARB>;
		clock-names = "apb", "smi";
	};

	smi_larb10: smi_larb10@15120000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15120000 0x1000>;
		mediatek,larb-id = <10>;
		mediatek,smi = <&smi_img_subcommon0>;
		mediatek,comm-port-id = <1>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_DIP1>;
		clocks = <&imgsys_main_clk CLK_IMG_DIP0>,
			 <&imgsys_main_clk CLK_IMG_DIP0>;
		clock-names = "apb", "smi";
	};

	smi_larb15: smi_larb15@15140000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15140000 0x1000>;
		mediatek,larb-id = <15>;
		mediatek,smi = <&smi_img_subcommon1>;
		mediatek,comm-port-id = <1>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_DIP1>;
		clocks = <&imgsys_main_clk CLK_IMG_DIP0>,
			 <&imgsys_main_clk CLK_IMG_DIP0>;
		clock-names = "apb", "smi";
	};

	smi_larb11: smi_larb11@15230000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15230000 0x1000>;
		mediatek,larb-id = <11>;
		mediatek,smi = <&smi_img_subcommon0>;
		mediatek,comm-port-id = <2>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_DIP1>;
		clocks = <&imgsys_main_clk CLK_IMG_WPE1>,
			 <&imgsys_main_clk CLK_IMG_WPE1>;
		clock-names = "apb", "smi";
	};

	smi_larb12: smi_larb12@15340000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15340000 0x1000>;
		mediatek,larb-id = <12>;
		mediatek,smi = <&smi_img_subcommon1>;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_IPE>;
		clocks = <&imgsys_main_clk CLK_IMG_IPE>,
			 <&imgsys_main_clk CLK_IMG_IPE>;
		clock-names = "apb", "smi";
	};

	smi_larb22: smi_larb22@15530000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15530000 0x1000>;
		mediatek,larb-id = <22>;
		mediatek,smi = <&smi_img_subcommon1>;
		mediatek,comm-port-id = <2>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_DIP1>;
		clocks = <&imgsys_main_clk CLK_IMG_WPE2>,
			 <&imgsys_main_clk CLK_IMG_WPE2>;
		clock-names = "apb", "smi";
	};

	smi_larb23: smi_larb23@15630000 {
		compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
		reg = <0x15630000 0x1000>;
		mediatek,larb-id = <23>;
		mediatek,smi = <&smi_img_subcommon0>;
		mediatek,comm-port-id = <3>;
		larb-clamp-ctrl-enable;
		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_DIP1>;
		clocks = <&imgsys_main_clk CLK_IMG_WPE2>,
			 <&imgsys_main_clk CLK_IMG_WPE2>;
		clock-names = "apb", "smi";
	};

	dip_top_dip1_clk: syscon@15110000 {
		compatible = "mediatek,mt6895-dip_top_dip1", "syscon";
		reg = <0x15110000 0x1000>;
		#clock-cells = <1>;
	};

	dip_nr_dip1_clk: syscon@15130000 {
		compatible = "mediatek,mt6895-dip_nr_dip1", "syscon";
		reg = <0x15130000 0x1000>;
		#clock-cells = <1>;
	};

	wpe1_dip1_clk: syscon@15220000 {
		compatible = "mediatek,mt6895-wpe1_dip1", "syscon";
		reg = <0x15220000 0x1000>;
		#clock-cells = <1>;
	};

	ipesys_clk: syscon@15330000 {
		compatible = "mediatek,mt6895-ipesys", "syscon";
		reg = <0x15330000 0x1000>;
		#clock-cells = <1>;
	};

	/*
	 * XAGA: the ME (IPE motion estimation) platform device.  Without this
	 * node ipesys_me_probe() never runs, so:
	 *   - me_dev stays NULL and ipesys_me_debug_dump() NULL-derefs inside
	 *     the CMDQ timeout workqueue (the oops at ipesys_me_debug_dump+0x38,
	 *     call trace imgsys_cmdq_task_cb -> cmdq_thread_handle_timeout_work),
	 *     which aborts the timeout cleanup and wedges the pipe;
	 *   - M4U_LARB12_PORT4/PORT5 are never registered in disp_iommu, so the
	 *     ME's RDMA/WDMA have no bank and issue IOVA 0;
	 *   - the ME engine's own CQ-done (event 221 / hw_comb 0x800) never fires.
	 */
	ipesys_me: ipesys_me@15320000 {
		compatible = "mediatek,ipesys-me";
		reg = <0x15320000 0x10000>;
		iommus = <&disp_iommu M4U_LARB12_PORT4>,
			 <&disp_iommu M4U_LARB12_PORT5>;
		clocks = <&imgsys_main_clk CLK_IMG_IPE_DUMMY>,
			 <&ipesys_clk CLK_IPESYS_TOP>,
			 <&ipesys_clk CLK_IPE_ME>,
			 <&ipesys_clk CLK_IPE_SMI_LARB12>;
		clock-names = "ME_CG_IPE", "ME_CG_IPE_TOP",
			      "ME_CG", "ME_CG_LARB12";
	};

	wpe2_dip1_clk: syscon@15520000 {
		compatible = "mediatek,mt6895-wpe2_dip1", "syscon";
		reg = <0x15520000 0x1000>;
		#clock-cells = <1>;
	};

	wpe3_dip1_clk: syscon@15620000 {
		compatible = "mediatek,mt6895-wpe3_dip1", "syscon";
		reg = <0x15620000 0x1000>;
		#clock-cells = <1>;
	};

	imgsys_fw: imgsys_fw@15000000 {
		compatible = "mediatek,imgsys";
		operating-points-v2 = <&opp_table_img>, <&opp_table_ipe>;
		reg = <0x15000000 0x4000>,	/* 0 IMGSYS_TOP */
		      <0x15020000 0x10000>,	/* 1 IMGSYS_TRAW */
		      <0x15040000 0x10000>,	/* 2 IMGSYS_LTRAW */
		      <0x15640000 0x10000>,	/* 3 IMGSYS_XTRAW */
		      <0x15100000 0x10000>,	/* 4 IMGSYS_DIP */
