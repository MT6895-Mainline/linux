		disp_mutex: disp_mutex@14001000 {
			compatible = "mediatek,disp_mutex0", "mediatek,mt6895-disp-mutex";
			reg = <0x14001000 0x1000>,
			      <0x14401000 0x1000>;
			interrupts = <GIC_SPI 0x12c IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x158 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&spm 20>;
			clocks = <&mmsys0 CLK_MM0_DISP_MUTEX0>,
				<&mmsys1 CLK_MM1_DISP_MUTEX0>;
			dispsys_num = <2>;
		};

		disp_ovl0: disp_ovl@14002000 {
			#address-cells = <2>;
			#size-cells = <2>;
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			compatible = "mediatek,mt6895-disp-ovl";
			reg = <0x14002000 0x1000>;
			interrupts = <GIC_SPI 0x12e IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys0 CLK_MM0_DISP_OVL0>;
			mediatek,larb = <&smi_larb0>;
			mediatek,smi-id = <0>;
			iommus = <&disp_iommu 0x07 &disp_iommu 0x02>;
			/*
			 * PEARL: without these the display never votes for bandwidth.
			 * of_mtk_icc_get() returns NULL when the node has no
			 * interconnects, so every mtk_icc_set_bw() call from the ovl driver is a
			 * no-op and the OVL underruns on every frame (that is the white
			 * screen).  Ports come from this node's own iommus, the names
			 * from ddp_comp_str[] -- DECLARE_STR stringifies the enum.
			 */
			interconnects = <&mmqos MASTER_LARB_PORT(0x7) &mmqos SLAVE_COMMON(0)>,
			                 <&mmqos MASTER_LARB_PORT(0x2) &mmqos SLAVE_COMMON(0)>,
			                 <&mmqos MASTER_LARB_PORT(0x7) &mmqos SLAVE_COMMON(0)>;
			interconnect-names = "DDP_COMPONENT_OVL0_qos",
			                    "DDP_COMPONENT_OVL0_fbdc_qos",
			                    "DDP_COMPONENT_OVL0_hrt_qos";
		};

