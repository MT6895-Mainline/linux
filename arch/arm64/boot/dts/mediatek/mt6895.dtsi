		dsi0: dsi@14017000 {
			compatible = "mediatek,mt6895-dsi";
			reg = <0x14017000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 0x143 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys0 CLK_MM0_FMM_DISP_DSI0>,
				<&mmsys0 CLK_MM0_DISP_DSI>,
				<&mipi_tx0>;
			clock-names = "engine", "digital", "hs";
			phys = <&mipi_tx0>;
			phy-names = "dphy";

			port {
				dsi_out: endpoint {
					remote-endpoint = <&panel_ep>;
				};
			};

			panel@1 {
				compatible = "l16_36_02_0b_dsc_vdo,lcm";
				reg = <1>;
				reset-gpios = <&pio 41 GPIO_ACTIVE_HIGH>;
				leden-gpios = <&pio 215 GPIO_ACTIVE_HIGH>;
				cam-gpios = <&pio 158 GPIO_ACTIVE_HIGH>;
				dvdd-gpios = <&pio 118 GPIO_ACTIVE_HIGH>;
				vrf18-supply = <&vrf18_reg>;
				backlight = <&gate_ic>;

				port {
					panel_ep: endpoint {
						remote-endpoint = <&dsi_out>;
					};
				};
			};
		};

