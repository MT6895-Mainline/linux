	opp_table_cam: opp-table-cam {
		compatible = "operating-points-v2";
		opp-0 {
			opp-hz = /bits/ 64 <273000000>;
			opp-microvolt = <550000>;
		};
		opp-1 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <575000>;
		};
		opp-2 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <600000>;
		};
		opp-3 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <650000>;
		};
		opp-4 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <700000>;
		};
	};

	opp_table_img: opp-table-img {
		compatible = "operating-points-v2";
		opp-0 {
			opp-hz = /bits/ 64 <264000000>;
			opp-microvolt = <550000>;
		};
		opp-1 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <575000>;
		};
		opp-2 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <600000>;
		};
		opp-3 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <650000>;
		};
		opp-4 {
			opp-hz = /bits/ 64 <660000000>;
			opp-microvolt = <700000>;
		};
	};

	opp_table_ipe: opp-table-ipe {
		compatible = "operating-points-v2";
		opp-0 {
			opp-hz = /bits/ 64 <273000000>;
			opp-microvolt = <550000>;
		};
		opp-1 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <575000>;
		};
		opp-2 {
			opp-hz = /bits/ 64 <364000000>;
			opp-microvolt = <600000>;
		};
		opp-3 {
			opp-hz = /bits/ 64 <458000000>;
			opp-microvolt = <650000>;
		};
		opp-4 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <700000>;
		};
	};

		vmm_proxy_label: vmm-proxy {
			regulator-name = "dvfs-vmm";
			regulator-min-microvolt = <550000>;
			regulator-max-microvolt = <700000>;
		};

		disp_iommu: iommu@1e802000 {
			compatible = "mediatek,mt6895-disp-iommu";
			reg = <0x1e802000 0x1000>;
			table_id = <0>;
			interrupts = <GIC_SPI 388 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_SMI>;
			clock-names = "bclk";
			mediatek,larbs = <&smi_larb0 &smi_larb2 &smi_larb5 &smi_larb7
						&smi_larb9 &smi_larb10 &smi_larb11
						&smi_larb13 &smi_larb21 &smi_larb23
						&smi_larb25 &smi_larb27 &smi_larb29
						&smi_larb30>;
			mediatek,iommu_banks = <&disp_iommu_bank1 &disp_iommu_bank2
						&disp_iommu_bank3 &disp_iommu_bank4>;
			#iommu-cells = <1>;
		};

		disp_pwm0: disp_pwm0@1100e000 {
			compatible = "mediatek,mt6895-disp-pwm";
			reg = <0x1100e000 0x1000>;
			interrupts = <GIC_SPI 0xd7 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>;
		};

		dispsys_config: dispsys_config@14000000 {
			/* PEARL: the display's global HRT bandwidth vote. */
			interconnects = <&mmqos MASTER_LARB_PORT(0x07) &mmqos SLAVE_COMMON(0)>;
			interconnect-names = "disp_hrt_qos";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			compatible = "mediatek,mt6895-disp";
			/*
			 * PEARL: both properties are required for mtk_disp_pmqos.c to
			 * enable its voting path.  The OPP table below has existed all
			 * along; nothing referenced it, so the display never voted for
			 * bandwidth and the OVL underran every frame.
			 */
			operating-points-v2 = <&opp_table_disp0>;
			dvfsrc-vcore-supply = <&dvfsrc_vcore>;
			dispsys_num = <2>;
			reg = <0x14000000 0x1000 0x14400000 0x1000>;
			iommus = <&disp_iommu 0x09>;
			mediatek,larb = <&smi_larb0>;
			power-domains = <&spm 19>;
			#clock-cells = <1>;
			clocks = <&mmsys0 CLK_MM0_DISP_MUTEX0>,
				<&mmsys1 CLK_MM1_DISP_MUTEX0>,
				<&mmsys0 CLK_MM0_APB_BUS>,
				<&mmsys1 CLK_MM1_APB_BUS>,
				<&mmsys0 CLK_MM0_SIG_EMI>,
				<&mmsys1 CLK_MM1_SIG_EMI>,
				<&mmsys0 CLK_MM0_DISP_DLI_ASYNC0>,
				<&mmsys0 CLK_MM0_DISP_DLO_ASYNC0>,
				<&mmsys0 CLK_MM0_DISP_DLI_ASYNC1>,
				<&mmsys0 CLK_MM0_DISP_DLO_ASYNC1>,
				<&mmsys0 CLK_MM0_DISP_DLI_ASYNC2>,
				<&mmsys0 CLK_MM0_DISP_DLO_ASYNC2>,
				<&mmsys0 CLK_MM0_DISP_DLI_ASYNC3>,
				<&mmsys0 CLK_MM0_DISP_DLO_ASYNC3>,
				<&mmsys1 CLK_MM1_DISP_DLI_ASYNC0>,
				<&mmsys1 CLK_MM1_DISP_DLO_ASYNC0>,
				<&mmsys1 CLK_MM1_DISP_DLI_ASYNC1>,
				<&mmsys1 CLK_MM1_DISP_DLO_ASYNC1>,
				<&mmsys1 CLK_MM1_DISP_DLI_ASYNC2>,
				<&mmsys1 CLK_MM1_DISP_DLO_ASYNC2>,
				<&mmsys1 CLK_MM1_DISP_DLI_ASYNC3>,
				<&mmsys1 CLK_MM1_DISP_DLO_ASYNC3>;
			clock-num = <22>;
			mediatek,mailbox-gce = <&gce>;
			mboxes = <&gce 0 0 4 &gce 1 0 4 &gce 2 0 4
				  &gce 3 0xffffffff 2 &gce 5 0xffffffff 2
				  &gce 4 0 4 &gce 6 0 3 &gce 22 0 1>;
			gce-client-names = "CLIENT_CFG0", "CLIENT_CFG1", "CLIENT_CFG2", "CLIENT_TRIG_LOOP0", "CLIENT_TRIG_LOOP1", "CLIENT_SUB_CFG0", "CLIENT_DSI_CFG0", "CLIENT_PQ0";
			gce-subsys = <&gce 0x14000000 1 &gce 0x14010000 2 &gce 0x14020000 3>;
