	/*
	 * A single PMU instance covering all eight CPUs, as in the vendor DTS.
	 *
	 * The 4th cell of the interrupt specifier is the PPI partition.  Keep
	 * it 0 (no partition): gic_irq_get_fwspec_info() then reports
	 * cpu_possible_mask as the affinity and arm_pmu sets
	 * supported_cpus = 0-7.
	 *
	 * Do not split this into per-cluster nodes (as mt8192/mt8195 do).
	 * That gives each instance a cluster-sized supported_cpus, which
	 * breaks KVM's guest PMU: kvm_pmu_probe_armpmu() latches
	 * kvm->arch.arm_pmu once, from raw_smp_processor_id(), at
	 * KVM_ARM_VCPU_PMU_V3_INIT time, but kvm_pmu_create_perf_event()
	 * creates a task-bound event (cpu = -1, task = current) that follows
	 * the vCPU.  armpmu_filter() silently rejects any CPU outside
	 * supported_cpus, so a vCPU that migrates to another cluster loses
	 * its counter and the guest reads a frozen PMCCNTR_EL0 -- which trips
	 * bootmgfw.efi's divide-by-zero (brk #0xf004) on Windows.
	 *
	 * "arm,armv8-pmuv3" is used for the whole PMU because arm_pmu derives
	 * the PMU name from the compatible alone, and it must be unique.
	 */
	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc: soc@0 {
		compatible = "simple-bus";
		ranges = <0x0 0x0 0x0 0x20000000>;

		#address-cells = <1>;
		#size-cells = <1>;


		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			reg = <0x0c000000 0x40000>,
			      <0x0c040000 0x200000>;
			#interrupt-cells = <4>;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		/* MT6895 CPU DVFS hardware (SPM/EMI-driven, see mediatek-cpufreq-hw).
		 * Domain 0 = 4x A55, 1 = 3x A78, 2 = 1x A78 (regs from live DT). */
		cpufreq: performance-controller@11bc10 {
			compatible = "mediatek,cpufreq-hw";
			reg = <0x11bc10 0x120>,
			      <0x11bd30 0x120>,
			      <0x11be50 0x120>;
			reg-names = "performance-domain0",
				    "performance-domain1",
				    "performance-domain2";
			#performance-domain-cells = <1>;
		};

		topckgen: syscon@10000000 {
			compatible = "mediatek,mt6895-topckgen", "syscon";
			reg = <0x10000000 0x1000>;
			#clock-cells = <1>;
			mediatek,hardware-voter = <&hwv>;
			hw-voter-regmap = <&hwv>;
		};

		infracfg_ao: syscon@10001000 {
			compatible = "mediatek,mt6895-infracfg_ao", "mediatek,mt6895-infracfg-ao", "syscon", "simple-mfd";
			reg = <0x10001000 0x1000>;
			#clock-cells = <1>;

			/* 第32轮：LVTS 的复位线（照抄 pearl，stock parity）。
			 * 必须给父节点加 "simple-mfd"，否则 of_platform_bus_create()
			 * 不会 populate 子节点（见 drivers/of/platform.c:371）。 */
			infracfg_rst: reset-controller {
				compatible = "ti,syscon-reset";
				#reset-cells = <1>;
				ti,reset-bits = <0x120 0x00 0x124 0x00 0x00 0x00
						 0x1c 0x730 0x0c 0x734 0x0c 0x00 0x00 0x1c>;
			};
		};

		infracfg_ao_mem: infracfg_ao_mem@10002000 {
			compatible = "mediatek,infracfg_ao_mem";
			reg = <0x10002000 0x1000>;
		};

		nemi_bus: syscon@10270000 {
			compatible = "mediatek,mt6895-nemi_bus", "syscon";
			reg = <0x10270000 0x1000>;
		};

		semi_bus: syscon@1030e000 {
			compatible = "mediatek,mt6895-semi_bus", "syscon";
			reg = <0x1030e000 0x1000>;
		};

		vlpcfg: syscon@1c00c000 {
			compatible = "mediatek,mt6895-vlpcfg_bus", "syscon";
			reg = <0x1c00c000 0x1000>;
		};

		vlp_cksys: syscon@1c013000 {
			compatible = "mediatek,mt6895-vlp_cksys", "syscon";
			reg = <0x1c013000 0x1000>;
			#clock-cells = <1>;
		};


		/* Shares 0x10005000 with pio (and the consys multi-reg) — same as
		 * stock, which also has both; unit-address/reg overlap by design.
		 */

		/* Shares 0x10001000 with infracfg_ao — expected DTC
		 * unique_unit_address warning (same precedent as the AFE pair).
		 */

		/* SCP clocks and ULPOSC calibration parameters from stock MT6895. */


		mfgrpc: syscon@13f91000 {
			compatible = "mediatek,mt6895-gpu_eb_rpc_bus", "syscon";
			reg = <0x13f91000 0x1000>;
		};

		mfgpll_pll_ctrl: syscon@13fa0000 {
			compatible = "mediatek,mt6895-mfgpll_pll_ctrl", "syscon";
			reg = <0x13fa0000 0x400>;
			#clock-cells = <1>;
		};

		mfgscpll_pll_ctrl: syscon@13fa0c00 {
			compatible = "mediatek,mt6895-mfgscpll_pll_ctrl", "syscon";
			reg = <0x13fa0c00 0x400>;
			#clock-cells = <1>;
		};

		mfgcfg: clock-controller@13fbf000 {
			compatible = "mediatek,mt6895-mfg";
			reg = <0x13fbf000 0x1000>;
			#clock-cells = <1>;
		};

		/*
		 * MT6895 SCP/SPM power-domain controller (scpsys). Provides the
		 * DISP(19)/DISP1(20)/MM_INFRA(6) MTCMOS domains required by the
		 * display SMI/IOMMU/GCE subsystem. Clock phandles now match the
		 * downstream MT6895 DT where the corresponding mainline clock
		 * drivers exist.
		 */
		spm: power-controller@1c001000 {
			compatible = "mediatek,mt6895-scpsys", "syscon";
			reg = <0x1c001000 0x1000>;
			#power-domain-cells = <1>;
			infracfg = <&infracfg_ao>;
			vlpcfg = <&vlpcfg>;
			mfgrpc = <&mfgrpc>;
			nemi_bus = <&nemi_bus>;
			semi_bus = <&semi_bus>;
			clocks = <&topckgen CLK_TOP_ADSP_SEL>,
				<&topckgen CLK_TOP_AUD_INTBUS_SEL>,
				<&topckgen CLK_TOP_CAM_SEL>,
				<&topckgen CLK_TOP_CCUSYS_SEL>,
				<&topckgen CLK_TOP_CCU_AHB_SEL>,
				<&topckgen CLK_TOP_DISP0_SEL>,
				<&topckgen CLK_TOP_DISP1_SEL>,
				<&topckgen CLK_TOP_MDP0_SEL>,
				<&topckgen CLK_TOP_MDP1_SEL>,
				<&topckgen CLK_TOP_MMINFRA_SEL>,
				<&topckgen CLK_TOP_MMUP_SEL>,
				<&topckgen CLK_TOP_IMG1_SEL>,
				<&topckgen CLK_TOP_IPE_SEL>,
				<&topckgen CLK_TOP_VDEC_SEL>,
				<&topckgen CLK_TOP_VENC_SEL>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_LARB13_CON>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_LARB14_CON>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM2MM0_GALS_CON>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM2MM1_GALS_CON>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM2SYS_GALS_CON>,
				<&mminfra_config CLK_MMINFRA_SMI>,
				<&mmsys0 CLK_MM0_SMI_COMMON>,
				<&mmsys1 CLK_MM1_SMI_COMMON>,
				<&mdpsys_config_clk CLK_MDP_SMI0>,
				<&mdpsys1_config_clk CLK_MDP1_SMI0>,
				<&imgsys_main_clk CLK_IMG_LARB9>,
				<&imgsys_main_clk CLK_IMG_ADL_LARB>,
				<&vdec_soc_gcon_base_clk CLK_VDE1_LARB1_CKEN>,
				<&vdec_gcon_base_clk CLK_VDE2_LARB1_CKEN>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM_SUBA_CON>,
				<&camsys_rawa_clk CLK_CAM_RA_LARBX>,
				<&camsys_yuva_clk CLK_CAM_YA_LARBX>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM_SUBB_CON>,
				<&camsys_rawb_clk CLK_CAM_RB_LARBX>,
				<&camsys_yuvb_clk CLK_CAM_YB_LARBX>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM_SUBC_CON>,
				<&camsys_rawc_clk CLK_CAM_RC_LARBX>,
				<&camsys_yuvc_clk CLK_CAM_YC_LARBX>,
				<&cam_main_r1a_clk CLK_CAM_MAIN_CAM_MRAW_CON>,
				<&camsys_mraw_clk CLK_CAM_MR_LARBX>,
				<&imgsys_main_clk CLK_IMG_IPE>,
				<&imgsys_main_clk CLK_IMG_DIP0>,
				<&imgsys_main_clk CLK_IMG_WPE0>,
				<&imgsys_main_clk CLK_IMG_WPE1>,
				<&imgsys_main_clk CLK_IMG_WPE2>;
			clock-names = "adsp", "audio", "cam", "ccu", "ccu_ahb",
				      "disp", "disp1", "mdp", "mdp1", "mm_infra",
				      "mmup", "isp", "ipe", "vde", "ven",
				      "cam_lp-0", "cam_lp-1", "cam_lp-2",
				      "cam_lp-3", "cam_lp-4",
				      "mm_infra_lp-0", "disp-0", "disp1-0",
				      "mdp-0", "mdp1-0", "isp-0", "isp-1",
				      "vde0-0", "vde1-0",
				      "cam_suba-0", "cam_suba-1", "cam_suba-2",
				      "cam_subb-0", "cam_subb-1", "cam_subb-2",
				      "cam_subc-0", "cam_subc-1", "cam_subc-2",
				      "cam_mraw-0", "cam_mraw-1", "ipe-0",
				      "dip1-0", "dip1-1", "dip1-2", "dip1-3";
		};

		pio: pinctrl {
			compatible = "mediatek,mt6895-pinctrl";
			reg = <0x10005000 0x1000>,
			      <0x11c20000 0x1000>,
			      <0x11c30000 0x1000>,
			      <0x11c40000 0x1000>,
			      <0x11d10000 0x1000>,
			      <0x11d30000 0x1000>,
			      <0x11d40000 0x1000>,
			      <0x11d50000 0x1000>,
			      <0x11d60000 0x1000>,
			      <0x11e10000 0x1000>,
			      <0x11ea0000 0x1000>,
			      <0x11eb0000 0x1000>,
			      <0x11f20000 0x1000>,
			      <0x11f30000 0x1000>;
			reg-names = "gpio",
				    "iocfg_rm",
				    "iocfg_rt",
				    "iocfg_rmm",
				    "iocfg_bl",
				    "iocfg_bm",
				    "iocfg_br",
				    "iocfg_brr",
				    "iocfg_lb",
				    "iocfg_lm",
				    "iocfg_rtt",
				    "iocfg_tr",
				    "iocfg_tl",
				    "iocfg_lt";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 247>;
			interrupt-controller;
			#interrupt-cells = <2>;
			mediatek,eint = <&apirq>;
		};

		apirq: apirq@11e50000 {
			compatible = "mediatek,mt6983-eint";
			reg = <0x11e50000 0x1000>,
			      <0x11ce0000 0x1000>,
			      <0x11de0000 0x1000>,
			      <0x11fe0000 0x1000>,
			      <0x1c01e000 0x1000>;
			reg-names = "eint-w", "eint-e", "eint-s",
				    "eint-n", "eint-c";
			interrupts = <GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH 0>;
			mediatek,total-pin-number = <247>;
			mediatek,instance-num = <5>;
			mediatek,pins = <0x00 0x03 0x00 0x01 0x01 0x03 0x01 0x01
					0x02 0x03 0x02 0x01 0x03 0x01 0x00 0x01
					0x04 0x01 0x01 0x01 0x05 0x01 0x02 0x01
					0x0a 0x01 0x03 0x01 0x0b 0x01 0x04 0x01
					0x0c 0x02 0x00 0x01 0x0d 0x02 0x01 0x01
					0x0e 0x02 0x02 0x01 0x0f 0x02 0x03 0x01
					0x10 0x00 0x00 0x01 0x11 0x00 0x01 0x01
					0x12 0x00 0x02 0x01 0x13 0x01 0x05 0x01
					0x14 0x02 0x04 0x00 0x15 0x02 0x05 0x00
					0x16 0x02 0x06 0x00 0x17 0x00 0x03 0x00
					0x18 0x02 0x07 0x00 0x19 0x00 0x04 0x00
					0x1a 0x00 0x05 0x00 0x1b 0x00 0x06 0x00
					0x1c 0x00 0x07 0x00 0x23 0x00 0x08 0x00
					0x24 0x00 0x09 0x00 0x25 0x01 0x06 0x00
					0x26 0x01 0x07 0x00 0x27 0x00 0x0a 0x00
