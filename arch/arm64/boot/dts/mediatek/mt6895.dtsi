			reg = <0x14422000 0x1000>;
			mediatek,larb-id = <21>;
			mediatek,smi = <&smi_common &smi_disp_subcommon1>;
			power-domains = <&spm 20>;
			clocks = <&mmsys1 CLK_MM1_SMI_COMMON>, <&mmsys1 CLK_MM1_SMI_COMMON>;
			clock-names = "apb", "smi";
		};



		mdp_iommu_bank1: iommu@1e811000 {
			compatible = "mediatek,common-mdp-iommu-bank1";
			mediatek,bank-id = <1>;
			reg = <0x1e811000 0x1000>;
			interrupts = <GIC_SPI 394 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		mdp_iommu_bank2: iommu@1e812000 {
			compatible = "mediatek,common-mdp-iommu-bank2";
			mediatek,bank-id = <2>;
			reg = <0x1e812000 0x1000>;
			interrupts = <GIC_SPI 395 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		mdp_iommu_bank3: iommu@1e813000 {
			compatible = "mediatek,common-mdp-iommu-bank3";
			mediatek,bank-id = <3>;
			reg = <0x1e813000 0x1000>;
			interrupts = <GIC_SPI 396 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		mdp_iommu_bank4: iommu@1e814000 {
			compatible = "mediatek,common-mdp-iommu-bank4";
			mediatek,bank-id = <4>;
			reg = <0x1e814000 0x1000>;
			interrupts = <GIC_SPI 397 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		mdp_iommu: iommu@1e810000 {
			compatible = "mediatek,mt6895-mdp-iommu";
			reg = <0x1e810000 0x1000>;
			table_id = <0>;
			interrupts = <GIC_SPI 393 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_SMI>;
			clock-names = "bclk";
			mediatek,larbs = <&smi_larb1 &smi_larb3 &smi_larb4
						&smi_larb8 &smi_larb12 &smi_larb14
						&smi_larb15 &smi_larb16 &smi_larb17
						&smi_larb18 &smi_larb20 &smi_larb22
						&smi_larb26 &smi_larb28>;
			mediatek,iommu_banks = <&mdp_iommu_bank1 &mdp_iommu_bank2
						&mdp_iommu_bank3 &mdp_iommu_bank4>;
			#iommu-cells = <1>;
		};

		disp_iommu_bank1: iommu@1e803000 {
			compatible = "mediatek,common-disp-iommu-bank1";
			mediatek,bank-id = <1>;
			reg = <0x1e803000 0x1000>;
			interrupts = <GIC_SPI 389 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		disp_iommu_bank2: iommu@1e804000 {
			compatible = "mediatek,common-disp-iommu-bank2";
			mediatek,bank-id = <2>;
			reg = <0x1e804000 0x1000>;
			interrupts = <GIC_SPI 390 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		disp_iommu_bank3: iommu@1e805000 {
			compatible = "mediatek,common-disp-iommu-bank3";
			mediatek,bank-id = <3>;
			reg = <0x1e805000 0x1000>;
			interrupts = <GIC_SPI 391 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		disp_iommu_bank4: iommu@1e806000 {
			compatible = "mediatek,common-disp-iommu-bank4";
			mediatek,bank-id = <4>;
			reg = <0x1e806000 0x1000>;
			interrupts = <GIC_SPI 392 IRQ_TYPE_LEVEL_HIGH 0>;
		};

	camisp: camisp@1a000000 {
		compatible = "mediatek,camisp";
		reg = <0x1a000000 0x1000>;
		reg-names = "base";
		mediatek,ccd = <&remoteproc_ccd>;
		power-domains = <&spm MT6895_POWER_DOMAIN_CAM_MAIN>;
		operating-points-v2 = <&opp_table_cam>;
		/*
		 * XAGA: vmm_proxy_label is a bare node (no compatible, no
		 * driver), so regulator_get() can never resolve it and the camsys
		 * ran "DFS without voltage scaling" - measured:
		 *   mtk-cam 1a000000.camisp: can't get dvfsrc-vcore
		 *   seninf-core 1a010000.seninf_top: can't get dvfsrc-vmm
		 * Point it at the real dvfsrc regulator, as the display/IPE
		 * consumers already do.
		 */
		/*
		 * PEARL: dvfsrc-vmm-supply is intentionally left out so the
		 * consumer gets a dummy regulator, i.e. the "DFS without
		 * voltage scaling" mode that xaga's comment above describes.
		 * The full DVFSRC driver has been bound since the xaga merge and
		 * this board is verified stable in this configuration.
		 */
		/* dvfs-vmm-supply = <&dvfsrc_vcore>; */
		mux_name = "cam";
		clk_src = "TOP_MAINPLL_D4_D2",
				"TOP_UNIVPLL_D4_D2", "TOP_UNIVPLL_D6",
				"TOP_MAINPLL_D4", "TOP_UNIVPLL_D4";
		clocks = <&topckgen CLK_TOP_CAM_SEL>,	        /* 0 */
			 <&topckgen CLK_TOP_MAINPLL_D4_D2>,	        /* 1 */
			 <&topckgen CLK_TOP_UNIVPLL_D4_D2>,	        /* 2 */
			 <&topckgen CLK_TOP_UNIVPLL_D6>,	        /* 3 */
			 <&topckgen CLK_TOP_MAINPLL_D4>,	        /* 4 */
			 <&topckgen CLK_TOP_UNIVPLL_D4>;	        /* 5 */
		clock-names = "cam",	                                /* 0 */
				"TOP_MAINPLL_D4_D2",	                /* 1 */
				"TOP_UNIVPLL_D4_D2",	                /* 2 */
				"TOP_UNIVPLL_D6",	                /* 3 */
				"TOP_MAINPLL_D4",	                /* 4 */
				"TOP_UNIVPLL_D4";	                /* 5 */
	};

	remoteproc_ccd: remoteproc_ccd@1a030000 {
		compatible = "mediatek,ccd";
		reg = <0x1a030000 0x10000>;
		iommus = <&mdp_iommu M4U_LARB16_PORT0>,
			 <&mdp_iommu M4U_LARB16_PORT1>,
			 <&mdp_iommu M4U_LARB16_PORT2>,
			 <&mdp_iommu M4U_LARB16_PORT3>,
			 <&mdp_iommu M4U_LARB16_PORT4>,
			 <&mdp_iommu M4U_LARB16_PORT5>,
			 <&mdp_iommu M4U_LARB16_PORT6>,
			 <&mdp_iommu M4U_LARB16_PORT7>,
			 <&mdp_iommu M4U_LARB16_PORT8>,
			 <&mdp_iommu M4U_LARB16_PORT9>,
			 <&mdp_iommu M4U_LARB16_PORT10>,
			 <&mdp_iommu M4U_LARB16_PORT11>,
			 <&mdp_iommu M4U_LARB16_PORT12>,
			 <&mdp_iommu M4U_LARB16_PORT13>,
			 <&mdp_iommu M4U_LARB16_PORT14>,
			 <&mdp_iommu M4U_LARB16_PORT15>,
			 <&mdp_iommu M4U_LARB16_PORT16>;
		msg_dev {
			mtk,rpmsg-name = "mtk_ccd_msgdev";
		};
	};

	cam_raw_a@1a030000 {
		compatible = "mediatek,cam-raw";
		reg = <0x1a030000 0x8000>,
			<0x1a038000 0x8000>;
		reg-names = "base", "inner_base";
		mediatek,cam-id = <0>;
		mediatek,larbs = <&smi_larb16>;
		interrupts = <GIC_SPI 428 IRQ_TYPE_LEVEL_HIGH 0>;
		power-domains = <&spm MT6895_POWER_DOMAIN_CAM_MAIN>;
		clocks = <&cam_main_r1a_clk CLK_CAM_MAIN_CAM2MM0_GALS_CON>,
			<&cam_main_r1a_clk CLK_CAM_MAIN_CAM2MM1_GALS_CON>,
			<&cam_main_r1a_clk CLK_CAM_MAIN_CAM2SYS_GALS_CON>,
			<&cam_main_r1a_clk CLK_CAM_MAIN_CAM_CON>,
			<&cam_main_r1a_clk CLK_CAM_MAIN_CAMTG_CON>,
			<&camsys_rawa_clk CLK_CAM_RA_LARBX_DUMMY>,
			<&camsys_rawa_clk CLK_CAM_RA_CAM>,
			<&camsys_rawa_clk CLK_CAM_RA_CAMTG>,
			<&topckgen CLK_TOP_CAM_SEL>,
			<&topckgen CLK_TOP_CAMTG_SEL>,
			<&topckgen CLK_TOP_CAMTM_SEL>;
		clock-names = "camsys_cam2mm0_cgpdn",
			"camsys_cam2mm1_cgpdn",
			"camsys_cam2sys_cgpdn",
			"camsys_cam_cgpdn",
			"camsys_camtg_cgpdn",
			"camsys_rawa_larbx_cgpdn",
			"camsys_rawa_cam_cgpdn",
			"camsys_rawa_camtg_cgpdn",
			"topckgen_top_cam_sel",
			"topckgen_top_camtg_sel",
			"topckgen_top_camtm_sel";
		iommus = <&mdp_iommu M4U_LARB16_PORT0>,
