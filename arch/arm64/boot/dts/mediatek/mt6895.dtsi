				 <&mmsys0 CLK_MM0_SMI_COMMON>,
				 <&mmsys0 CLK_MM0_SMI_COMMON>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_disp_subcommon1: smi_sub_comm1@14423000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x14423000 0x1000>;
			smi-supply = <&smi_sysram_common>;
			mediatek,smi = <&smi_sysram_common>;
			mediatek,common-id = <11>;
			init-power-on;
			power-domains = <&spm 20>;
			clocks = <&mmsys1 CLK_MM1_SMI_COMMON>,
