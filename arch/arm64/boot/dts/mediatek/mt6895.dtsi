audio_sram@1e102000 {
compatible = "mediatek,audio_sram";
reg = <0x1e102000 0x18000>;
prefer_mode = <0>;
mode_size = <0x12000 0x18000>;
block_size = <0x1000>;
};



		gpueb: gpueb@13c40000 {
			compatible = "mediatek,gpueb";
			gpueb-support = <1>;
			gpueb-logger-support = <0>;
			mbox_count = <1>;
			mbox_size = <160>; /* slots */
			slot_size = <4>;   /* bytes */
			ts_mbox = <0>; /* mbox for timersync */

			/* id, mbox, send_size */
			send_table =
				<0 0 4>,
				<1 0 8>,
				<2 0 3>,
				<3 0 3>,
				<4 0 9>,
				<5 0 4>,
				<6 0 6>,
				<7 0 6>;
			send_name_table =
				"IPI_ID_FAST_DVFS_EVENT",
				"IPI_ID_GPUFREQ",
				"IPI_ID_SLEEP",
				"IPI_ID_TIMER",
				"IPI_ID_FHCTL",
				"IPI_ID_CCF",
				"IPI_ID_GPUMPU",
				"IPI_ID_FAST_DVFS";

			/* id, mbox, recv_size, recv_opt */
			recv_table =
				<0 0 4 0>,
				<1 0 8 1>,
				<2 0 1 0>,
				<3 0 1 0>,
				<4 0 1 1>,
				<5 0 4 1>,
				<6 0 1 1>,
				<7 0 6 1>;
			recv_name_table =
				"IPI_ID_FAST_DVFS_EVENT",
				"IPI_ID_GPUFREQ",
				"IPI_ID_SLEEP",
				"IPI_ID_TIMER",
				"IPI_ID_FHCTL",
				"IPI_ID_CCF",
				"IPI_ID_GPUMPU",
				"IPI_ID_FAST_DVFS";

			reg = <0x13c40000 0x22000>,
			      <0x13c5fd80 0x280>,
			      <0x13c62004 0x4>,
			      <0x13c62074 0x4>,
			      <0x13c62000 0x4>,
			      <0x13c62078 0x4>;
			reg-names = "gpueb_base", "mbox0_base", "mbox0_set",
				    "mbox0_clr", "mbox0_send", "mbox0_recv";

			interrupts = <GIC_SPI 516 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "mbox0";

			gpueb_mem_table =
				<0 0x1000>,   /* 4KB   MEM_ID_GPUFREQ */
				<1 0x180000>; /* 1.5MB MEM_ID_LOG */
			gpueb_mem_name_table = "MEM_ID_GPUFREQ", "MEM_ID_LOG";
		};

		/*
		 * Mali-G610 MC6 (Dimensity 8100). Stock DT compatible is
		 * "mediatek,mali","arm,mali-valhall" which does NOT match any
		 * mainline driver; panthor binds "arm,mali-valhall-csf" (G610 is
		 * arch 10 / CSF). The stock node has 5 IRQs (GPU/MMU/JOB/EVENT/
		 * PWR, upper-case) but panthor does platform_get_irq_byname()
		 * with lowercase "gpu"/"mmu"/"job", so names are re-cased here and
		 * the IRQ numbers are taken from the merged stock DT (0x200/0x201/
		 * 0x202 = GIC SPI 512/513/514).
		 *
		 * The MT6895 GPU MTCMOS is split into MFG1..MFG12.  Downstream
		 * attaches all twelve domains to the GPU node and powers them
		 * through PM runtime; the PDCv2 registers then let the GPU
		 * control the finer shader/stack domains.  Without MFG2-12 the
		 * shader cores never become ready (shader_ready stays 0) and the
		 * MCU firmware hangs before writing the shared interface version.
		 */
		gpu: gpu@13000000 {
			compatible = "arm,mali-valhall-csf";
			reg = <0x13000000 0x480000>;
			interrupts = <GIC_SPI 514 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 513 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 512 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "job", "mmu", "gpu";
			/* Keep only the panthor-required core clock. Real GPU power/clock
			 * management is done by gpueb on MT6895; direct DT clock/power-domain
			 * control conflicts with the EB and can hang shader jobs.
			 */
			clocks = <&topckgen CLK_TOP_MFG_SEL_0_CK>;
			clock-names = "core";
			operating-points-v2 = <&gpu_opp_table>;
			mali-supply = <&vdd_gpu>;
			#cooling-cells = <2>;
		};

		/*
		 * GCE (global command engine) display instance, used by cmdq to
		 * drive the DDP components per-frame (SOF/EOF sync). LK leaves it
		 * clocked; the "gce"/"gce-timer" clocks are fixed stubs (the real
		 * sources are infracfg_ao gates). Only the display GCE is wired up
		 * here; the multimedia GCE (0x1e990000) is not used by the panel.
		 */
		mminfra_config: syscon@1e800000 {
			compatible = "mediatek,mt6895-mminfra_config", "syscon";
			reg = <0x1e800000 0x1000>;
			#clock-cells = <1>;
		};

		mminfra_debug: mminfra-debug@1e827000 {
			compatible = "mediatek,mminfra-debug";
			reg = <0x1e827000 0x90>;
			power-domains = <&spm 6>;
			interrupts = <GIC_SPI 403 IRQ_TYPE_LEVEL_HIGH 0>;
			mminfra-bkrs = <1>;
			init-clk-on;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "clk0", "clk1", "clk2", "clk3";
		};

		gce: gce@1e980000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,mt6895-gce";
			reg = <0x1e980000 0x4000>;
			interrupts = <GIC_SPI 401 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <3>;
			#gce-event-cells = <1>;
			#gce-subsys-cells = <2>;
			default_tokens = /bits/ 16 <0x2bc 0x2bd 0x2be 0x2bf 0x2c0
						     0x2c6 0x2c7 0x2aa 0x2ad 0x2b0
						     0x2b3>;
			power-domains = <&spm 6>;
			mediatek,smi = <&smi_mdp_comm>;
			unprepare_in_idle;
			gce_in_vcp;
			mboxes = <&gce 13 0xffffffff 1>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "gce", "gce-timer";
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			iommus = <&mdp_iommu 0x401>;
			dma_mask_bit = <0x22>;
		};

		/*
		 * SMI (smart multimedia interface) common/sub-common tree for the
		 * display/MDP/sysram path, matching downstream MT6895.
		 * Suppliers are declared before consumers so the SMI driver can
		 * probe the whole tree without deferred-probe reordering.
		 * LARBs reference both their top-level common and their local
		 * display sub-common; the downstream SMI driver links both.
		 */
		smi_infra_disp_subcommon0: smi_infra_disp_subcomm0@1e809000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e809000 0x1000>;
			mediatek,common-id = <3>;
			init-power-on;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_infra_disp_subcommon1: smi_infra_disp_subcomm1@1e80a000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80a000 0x1000>;
			mediatek,common-id = <4>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_mdp_subcommon4: smi_mdp_subcomm4@1e817000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e817000 0x1000>;
			mediatek,common-id = <5>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_mdp_subcommon5: smi_mdp_subcomm5@1e818000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e818000 0x1000>;
			mediatek,common-id = <6>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_subcommon3: smi_sysram_subcomm3@1e80d000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80d000 0x1000>;
			mediatek,common-id = <8>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_subcommon4: smi_sysram_subcomm4@1e80e000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80e000 0x1000>;
			mediatek,common-id = <9>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_common: smi_sysram_comm@1e80b000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon";
			reg = <0x1e80b000 0x1000>;
			mediatek,smi = <&smi_sysram_subcommon3 &smi_sysram_subcommon4>;
			mediatek,common-id = <2>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_subcommon2: smi_sysram_subcomm2@1e80c000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80c000 0x1000>;
			mediatek,smi = <&smi_sysram_common>;
			mediatek,common-id = <7>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_common: smi_common@1e801000 {
			compatible = "mediatek,mt6895-smi-common", "mediatek,smi-common", "syscon";
			reg = <0x1e801000 0x1000>;
			mediatek,smi = <&smi_infra_disp_subcommon0 &smi_infra_disp_subcommon1>;
			mediatek,common-id = <0>;
			smi-common;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_mdp_comm: smi_mdp_comm@1e80f000 {
			compatible = "mediatek,mt6895-smi-common", "mediatek,smi-common", "syscon";
			reg = <0x1e80f000 0x1000>;
			mediatek,smi = <&smi_mdp_subcommon4 &smi_mdp_subcommon5>;
