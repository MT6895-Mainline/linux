			power-domains = <&spm 22>;
			clocks = <&vdec_gcon_base_clk CLK_VDE2_LARB1_CKEN>,
				 <&vdec_gcon_base_clk CLK_VDE2_LARB1_CKEN>;
			clock-names = "apb", "smi";
		};


		smi_larb7: smi_larb7@17010000 {
			compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
			reg = <0x17010000 0x10000>;
			mediatek,larb-id = <7>;
			mediatek,smi = <&smi_mdp_comm &smi_sysram_common>;
			power-domains = <&spm 23>;
			clocks = <&venc_gcon_core0_clk CLK_VEN1_CKE1_VENC>,
				 <&venc_gcon_core0_clk CLK_VEN1_CKE0_LARB>;
			clock-names = "apb", "smi";
		};

		smi_larb8: smi_larb8@17810000 {
			compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
			reg = <0x17810000 0x10000>;
			mediatek,larb-id = <8>;
			mediatek,smi = <&smi_mdp_comm &smi_sysram_common>;
			power-domains = <&spm 24>;
			clocks = <&venc_gcon_core1_clk CLK_VEN2_CKE1_VENC>,
				 <&venc_gcon_core1_clk CLK_VEN2_CKE0_LARB>;
			clock-names = "apb", "smi";
		};

		smi_larb20: smi_larb20@14421000 {
			compatible = "mediatek,mt6895-smi-larb", "mediatek,smi-larb";
			reg = <0x14421000 0x1000>;
			mediatek,larb-id = <20>;
			mediatek,smi = <&smi_mdp_comm &smi_disp_subcommon1>;
			init-power-on;
			power-domains = <&spm 20>;
			clocks = <&mmsys1 CLK_MM1_SMI_COMMON>, <&mmsys1 CLK_MM1_SMI_COMMON>;
			clock-names = "apb", "smi";
		};

		smi_larb21: smi_larb21@14422000 {
