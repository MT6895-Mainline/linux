			 * no-op and the OVL underruns on every frame (that is the white
			 * screen).  Ports come from this node's own iommus, the names
			 * from ddp_comp_str[] -- DECLARE_STR stringifies the enum.
			 */
			interconnects = <&mmqos MASTER_LARB_PORT(0x288) &mmqos SLAVE_COMMON(1)>,
			                 <&mmqos MASTER_LARB_PORT(0x283) &mmqos SLAVE_COMMON(1)>,
			                 <&mmqos MASTER_LARB_PORT(0x288) &mmqos SLAVE_COMMON(1)>;
			interconnect-names = "DDP_COMPONENT_OVL2_2L_qos",
			                    "DDP_COMPONENT_OVL2_2L_fbdc_qos",
			                    "DDP_COMPONENT_OVL2_2L_hrt_qos";
		};

		disp_ovl3_2l: disp_ovl@14404000 {
			#address-cells = <2>;
			#size-cells = <2>;
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			compatible = "mediatek,mt6895-disp-ovl";
			reg = <0x14404000 0x1000>;
			interrupts = <GIC_SPI 0x15c IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys1 CLK_MM1_DISP_OVL1_2L>;
			mediatek,larb = <&smi_larb20>;
			mediatek,smi-id = <0x14>;
			iommus = <&disp_iommu 0x289 &disp_iommu 0x284>;
			/*
			 * PEARL: without these the display never votes for bandwidth.
			 * of_mtk_icc_get() returns NULL when the node has no
			 * interconnects, so every mtk_icc_set_bw() call from the ovl driver is a
			 * no-op and the OVL underruns on every frame (that is the white
			 * screen).  Ports come from this node's own iommus, the names
			 * from ddp_comp_str[] -- DECLARE_STR stringifies the enum.
			 */
			interconnects = <&mmqos MASTER_LARB_PORT(0x289) &mmqos SLAVE_COMMON(1)>,
			                 <&mmqos MASTER_LARB_PORT(0x284) &mmqos SLAVE_COMMON(1)>,
			                 <&mmqos MASTER_LARB_PORT(0x289) &mmqos SLAVE_COMMON(1)>;
			interconnect-names = "DDP_COMPONENT_OVL3_2L_qos",
			                    "DDP_COMPONENT_OVL3_2L_fbdc_qos",
			                    "DDP_COMPONENT_OVL3_2L_hrt_qos";
		};

		disp_rsz1: disp_rsz0@14405000 {
			compatible = "mediatek,mt6895-disp-rsz";
			reg = <0x14405000 0x1000>;
			interrupts = <GIC_SPI 0x15d IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys1 CLK_MM1_DISP_RSZ0>;
		};

		disp_rdma2: disp_rdma@14406000 {
			#address-cells = <2>;
			#size-cells = <2>;
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			compatible = "mediatek,mt6895-disp-rdma";
			reg = <0x14406000 0x1000>;
			interrupts = <GIC_SPI 0x15e IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys1 CLK_MM1_DISP_RDMA0>;
			mediatek,larb = <&smi_larb20>;
			mediatek,smi-id = <0x14>;
			iommus = <&disp_iommu 0x28c>;
			/*
			 * PEARL: RDMA2 is the read DMA of the second display pipe,
			 * which this panel does use.  Like RDMA1 and the mmsys1
			 * OVLs it hangs off larb20, whose mmqos path ends at the
			 * MDP common, so this is SLAVE_COMMON(1).  Without the
			 * declaration the DMA fetched with no bandwidth reserved
			 * for it and underran as soon as the interconnect was
			 * loaded (the camera probe at session start was enough).
			 */
			interconnects = <&mmqos MASTER_LARB_PORT(0x28c) &mmqos SLAVE_COMMON(1)>,
			                 <&mmqos MASTER_LARB_PORT(0x28c) &mmqos SLAVE_COMMON(1)>;
			interconnect-names = "DDP_COMPONENT_RDMA2_qos",
			                    "DDP_COMPONENT_RDMA2_hrt_qos";
		};

