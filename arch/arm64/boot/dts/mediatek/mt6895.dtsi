audio_sram@1e102000 {
compatible = "mediatek,audio_sram";
reg = <0x1e102000 0x18000>;
prefer_mode = <0>;
mode_size = <0x12000 0x18000>;
block_size = <0x1000>;
};



		gpueb: gpueb@13c40000 {
			compatible = "mediatek,gpueb";
			gpueb-support = <1>;
			gpueb-logger-support = <0>;
			mbox_count = <1>;
			mbox_size = <160>; /* slots */
			slot_size = <4>;   /* bytes */
			ts_mbox = <0>; /* mbox for timersync */

			/* id, mbox, send_size */
			send_table =
				<0 0 4>,
				<1 0 8>,
				<2 0 3>,
				<3 0 3>,
				<4 0 9>,
				<5 0 4>,
				<6 0 6>,
				<7 0 6>;
			send_name_table =
				"IPI_ID_FAST_DVFS_EVENT",
				"IPI_ID_GPUFREQ",
				"IPI_ID_SLEEP",
				"IPI_ID_TIMER",
				"IPI_ID_FHCTL",
				"IPI_ID_CCF",
				"IPI_ID_GPUMPU",
				"IPI_ID_FAST_DVFS";

			/* id, mbox, recv_size, recv_opt */
			recv_table =
				<0 0 4 0>,
				<1 0 8 1>,
				<2 0 1 0>,
				<3 0 1 0>,
				<4 0 1 1>,
				<5 0 4 1>,
				<6 0 1 1>,
				<7 0 6 1>;
			recv_name_table =
				"IPI_ID_FAST_DVFS_EVENT",
				"IPI_ID_GPUFREQ",
				"IPI_ID_SLEEP",
				"IPI_ID_TIMER",
				"IPI_ID_FHCTL",
				"IPI_ID_CCF",
				"IPI_ID_GPUMPU",
				"IPI_ID_FAST_DVFS";

			reg = <0x13c40000 0x22000>,
			      <0x13c5fd80 0x280>,
			      <0x13c62004 0x4>,
			      <0x13c62074 0x4>,
			      <0x13c62000 0x4>,
			      <0x13c62078 0x4>;
			reg-names = "gpueb_base", "mbox0_base", "mbox0_set",
				    "mbox0_clr", "mbox0_send", "mbox0_recv";

			interrupts = <GIC_SPI 516 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "mbox0";

			gpueb_mem_table =
				<0 0x1000>,   /* 4KB   MEM_ID_GPUFREQ */
				<1 0x180000>; /* 1.5MB MEM_ID_LOG */
			gpueb_mem_name_table = "MEM_ID_GPUFREQ", "MEM_ID_LOG";
		};

		/*
		 * Mali-G610 MC6 (Dimensity 8200). Stock DT compatible is
		 * "mediatek,mali","arm,mali-valhall" which does NOT match any
		 * mainline driver; panthor binds "arm,mali-valhall-csf" (G610 is
		 * arch 10 / CSF). The stock node has 5 IRQs (GPU/MMU/JOB/EVENT/
		 * PWR, upper-case) but panthor does platform_get_irq_byname()
		 * with lowercase "gpu"/"mmu"/"job", so names are re-cased here and
		 * the IRQ numbers are taken from the merged stock DT (0x200/0x201/
		 * 0x202 = GIC SPI 512/513/514).
		 *
		 * The MT6895 GPU MTCMOS is split into MFG1..MFG12.  Downstream
		 * attaches all twelve domains to the GPU node and powers them
		 * through PM runtime; the PDCv2 registers then let the GPU
		 * control the finer shader/stack domains.  Without MFG2-12 the
		 * shader cores never become ready (shader_ready stays 0) and the
		 * MCU firmware hangs before writing the shared interface version.
		 */
		gpu: gpu@13000000 {
			compatible = "arm,mali-valhall-csf";
			reg = <0x13000000 0x480000>;
			interrupts = <GIC_SPI 514 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 513 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 512 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "job", "mmu", "gpu";
			/* Core clock comes from MFG_SEL_0 (MFGPLL / 231M ref).
			 * The shader-complex "stacks" clock lives behind MFG_SEL_1
			 * (MFGSCPLL / 218M ref); downstream gpufreq scales it
			 * together with the GPU OPP, so expose it to panthor too.
			 * Real power management stays with gpueb; no power-domains.
			 */
			clocks = <&topckgen CLK_TOP_MFG_SEL_0_CK>,
				 <&topckgen CLK_TOP_MFG_SEL_1_CK>;
			clock-names = "core", "stacks";
			/* VSTACK: MT6368 BUCK2, scaled with the stacks clock
			 * using the downstream gpufreq_mt6895 rate/volt pairs.
			 */
			vstack-supply = <&mt6368_vbuck2>;
			operating-points-v2 = <&gpu_opp_table>;
			mali-supply = <&vdd_gpu>;
			#cooling-cells = <2>;
		};

		/*
		 * GCE (global command engine) display instance, used by cmdq to
		 * drive the DDP components per-frame (SOF/EOF sync). LK leaves it
		 * clocked; the "gce"/"gce-timer" clocks are fixed stubs (the real
		 * sources are infracfg_ao gates). Only the display GCE is wired up
		 * here; the multimedia GCE (0x1e990000) is not used by the panel.
		 */
		mminfra_config: syscon@1e800000 {
			compatible = "mediatek,mt6895-mminfra_config", "syscon";
			reg = <0x1e800000 0x1000>;
			#clock-cells = <1>;
		};

		mminfra_debug: mminfra-debug@1e827000 {
			compatible = "mediatek,mminfra-debug";
			reg = <0x1e827000 0x90>;
			power-domains = <&spm 6>;
			interrupts = <GIC_SPI 403 IRQ_TYPE_LEVEL_HIGH 0>;
			mminfra-bkrs = <1>;
			init-clk-on;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "clk0", "clk1", "clk2", "clk3";
		};

		/*
		 * DRAMC: read-only visibility into the DRAM controller
		 * (fmeter data-rate reporting, DDR type / mode-register info).
		 * Register layout and fmeter tuning values mirror the stock DT.
		 */
		dramc: dramc@10230000 {
			compatible = "mediatek,mt6895-dramc",
				     "mediatek,common-dramc";
			reg = <0x10230000 0x2000>, /* DRAMC AO CHA */
			      <0x10240000 0x2000>, /* DRAMC AO CHB */
			      <0x10250000 0x2000>, /* DRAMC AO CHC */
			      <0x10260000 0x2000>, /* DRAMC AO CHD */
			      <0x10234000 0x1000>, /* DRAMC NAO CHA */
			      <0x10244000 0x1000>, /* DRAMC NAO CHB */
			      <0x10254000 0x1000>, /* DRAMC NAO CHC */
			      <0x10264000 0x1000>, /* DRAMC NAO CHD */
			      <0x10238000 0x2000>, /* DDRPHY AO CHA */
			      <0x10248000 0x2000>, /* DDRPHY AO CHB */
			      <0x10258000 0x2000>, /* DDRPHY AO CHC */
			      <0x10268000 0x2000>, /* DDRPHY AO CHD */
			      <0x10236000 0x1000>, /* DDRPHY NAO CHA */
			      <0x10246000 0x1000>, /* DDRPHY NAO CHB */
			      <0x10256000 0x1000>, /* DDRPHY NAO CHC */
			      <0x10266000 0x1000>, /* DDRPHY NAO CHD */
			      <0x10006000 0x1000>; /* SLEEP BASE */
			mr4_version = <0>;
			mr4_rg = <0x0090 0x0000ffff 0>;
			fmeter_version = <1>;
			crystal_freq = <52>;
			pll_id = <0x050c 0x00000100 8>;
			shu_lv = <0x050c 0x00030000 16>;
			shu_of = <0x900>;
			sdmpcw = <0x0904 0xffff0000 16>,
				 <0x0924 0xffff0000 16>;
			prediv = <0x0908 0x000c0000 18>,
				 <0x0928 0x000c0000 18>;
			posdiv = <0x0908 0x00000007 0>,
				 <0x0928 0x00000007 0>;
			ckdiv4 = <0x0ef4 0x00000004 2>,
				 <0x0ef4 0x00000004 2>;
			pll_md = <0x0944 0x00000100 8>,
				 <0x0944 0x00000100 8>;
			cldiv2 = <0x0f34 0x00000002 1>,
				 <0x0f34 0x00000002 1>;
			fbksel = <0x090c 0x00000040 6>,
				 <0x090c 0x00000040 6>;
			dqsopen = <0x0ef0 0x00100000 20>,
				  <0x0ef0 0x00100000 20>;
			dqopen = <0x0ef0 0x00200000 21>,
				 <0x0ef0 0x00200000 21>;
			ckdiv4_ca = <0x0e74 0x00000004 2>,
				    <0x0e74 0x00000004 2>;
		};

		/*
		 * The DVFSRC collects voltage and DRAM bandwidth requests from
		 * the multimedia blocks and drives the VCORE rail (MT6363
		 * VBUCK2) itself. Clients request a voltage through their OPP
		 * table; the hardware serves the highest request.
		 */
		dvfsrc: system-controller@1c00f000 {
			/*
			 * Bound by drivers/soc/mediatek/mtk-dvfsrc.c
			 * (CONFIG_MTK_DVFSRC), which sends MTK_SIP_DVFSRC_START
			 * from its own probe to release the high-OPP lock INIT
			 * leaves held, after which SW_REQ acts as a floor and the
			 * hardware bandwidth voters scale DRAM on demand.  The same
			 * driver is the interconnect provider for the display's and
			 * the codecs' DRAM bandwidth votes.
			 *
			 * PEARL: this used to also list "mediatek,mt6895-dvfsrc-pin"
			 * so that a legacy manual-pinning driver would bind, while the
			 * generic driver was kept off (its half-port hung this board).
			 * With the full driver in place only the generic compatible may
			 * be listed: two compatibles resolve to different drivers and
			 * the second entry would win the match on a "first compatible
			 * wins" platform, leaving this node bound to the wrong driver
			 * while every consumer points at the DVFSRC.
			 */
			compatible = "mediatek,mt6895-dvfsrc";
			reg = <0x1c00f000 0x1000>;
			#interconnect-cells = <1>;
			clocks = <&vlp_cksys CLK_VLP_CK_DVFSRC>;

			regulators {
				compatible = "mediatek,mt6895-dvfsrc-regulator";
				clocks = <&topckgen CLK_TOP_DISP0_SEL>,
					 <&topckgen CLK_TOP_DISP1_SEL>,
					 <&topckgen CLK_TOP_MMINFRA_SEL>,
					 <&topckgen CLK_TOP_VENC_SEL>,
					 <&topckgen CLK_TOP_VDEC_SEL>,
					 <&topckgen CLK_TOP_MDP0_SEL>,
					 <&topckgen CLK_TOP_MDP1_SEL>,
					 <&topckgen CLK_TOP_UNIVPLL_D6_D2>,
					 <&topckgen CLK_TOP_UNIVPLL_D5_D2>,
					 <&topckgen CLK_TOP_MAINPLL_D5>,
					 <&topckgen CLK_TOP_UNIVPLL_D4>,
					 <&topckgen CLK_TOP_MAINPLL_D5_D2>,
					 <&topckgen CLK_TOP_MAINPLL_D4_D2>,
					 <&topckgen CLK_TOP_MMPLL_D4>,
					 <&topckgen CLK_TOP_UNIVPLL_D4_D2>,
					 <&topckgen CLK_TOP_MMPLL_D6>,
					 <&topckgen CLK_TOP_UNIVPLL_D6>,
					 <&topckgen CLK_TOP_TVDPLL>,
					 <&topckgen CLK_TOP_IMGPLL_D2>,
					 <&topckgen CLK_TOP_MMPLL_D6_D2>;
				clock-names = "disp0",
					      "disp1",
					      "mminfra",
					      "venc",
					      "vdec",
					      "mdp0",
					      "mdp1",
					      "univpll-d6-d2",
					      "univpll-d5-d2",
					      "mainpll-d5",
					      "univpll-d4",
					      "mainpll-d5-d2",
					      "mainpll-d4-d2",
					      "mmpll-d4",
					      "univpll-d4-d2",
					      "mmpll-d6",
					      "univpll-d6",
					      "tvdpll",
					      "imgpll-d2",
					      "mmpll-d6-d2";

				dvfsrc_vcore: dvfsrc-vcore {
					regulator-name = "dvfsrc-vcore";
					regulator-min-microvolt = <575000>;
					regulator-max-microvolt = <750000>;
				};

				dvfsrc_vscp: dvfsrc-vscp {
					regulator-name = "dvfsrc-vscp";
					regulator-min-microvolt = <575000>;
					regulator-max-microvolt = <750000>;
				};
			};
		};

		/*
		 * MMQoS interconnect provider: collects SMI port bandwidth
		 * requests from the multimedia masters (camera, display, MDP,
		 * codecs) and drives the SMI BWL/OSTD settings and the DVFSRC
		 * EMI bandwidth requests.  smi_larb6 and smi_larb19 do not
		 * exist on MT6895 and are omitted; smi_larb24 is unused.
		 */
		/*
		 * PEARL: a standalone EMI interconnect provider.  mtk-emi.c
		 * binds to this compatible directly, so mmqos gets its
		 * icc-bw path with the DVFSRC driver left disabled.
		 */
		emi_icc: interconnect-emi {
			compatible = "mediatek,mt6895-emi-icc";
			#interconnect-cells = <1>;
		};

		mmqos: interconnect {
			compatible = "mediatek,mt6895-mmqos";
			#mtk-interconnect-cells = <1>;
			/*
			 * The vendor consumers use #mtk-interconnect-cells, but
			 * fw_devlink only understands #interconnect-cells and
			 * uses it to order the multimedia consumers after this
			 * provider.  Both describe the same one-cell layout.
			 */
			#interconnect-cells = <1>;
			mediatek,larbs = <&smi_larb0 &smi_larb1 &smi_larb2
					  &smi_larb3 &smi_larb4 &smi_larb5
					  &smi_larb7 &smi_larb8 &smi_larb9
					  &smi_larb10 &smi_larb11 &smi_larb12
					  &smi_larb13 &smi_larb14 &smi_larb15
					  &smi_larb16 &smi_larb17 &smi_larb18
					  &smi_larb20 &smi_larb21 &smi_larb22
					  &smi_larb23 &smi_larb25 &smi_larb26
					  &smi_larb27 &smi_larb28 &smi_larb29
					  &smi_larb30>;
			mediatek,commons = <&smi_common>, <&smi_mdp_comm>;
			clocks = <&topckgen CLK_TOP_MMINFRA_SEL>,
				 <&topckgen CLK_TOP_MMINFRA_SEL>;
			clock-names = "mm", "mdp";
			/*
			 * PEARL: pointed at the standalone EMI interconnect node
			 * instead of &dvfsrc.  mmqos only needs a provider with
			 * #interconnect-cells; using the DVFSRC node dragged in
			 * its driver, which programs VCORE and hung this board
			 * (twice, white screen, fastboot recovery each time).
			 */
			interconnects = <&emi_icc MT6873_MASTER_MMSYS
					 &emi_icc MT6873_SLAVE_DDR_EMI>,
					<&emi_icc MT6873_MASTER_HRT_MMSYS
					 &emi_icc MT6873_SLAVE_HRT_DDR_EMI>;
			interconnect-names = "icc-bw", "icc-hrt-bw";
		};

		gce: gce@1e980000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,mt6895-gce";
			reg = <0x1e980000 0x4000>;
			interrupts = <GIC_SPI 401 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <3>;
			#gce-event-cells = <1>;
			#gce-subsys-cells = <2>;
			default_tokens = /bits/ 16 <0x2bc 0x2bd 0x2be 0x2bf 0x2c0
						     0x2c6 0x2c7 0x2aa 0x2ad 0x2b0
						     0x2b3>;
			power-domains = <&spm 6>;
			mediatek,smi = <&smi_mdp_comm>;
			unprepare_in_idle;
			gce_in_vcp;
			mboxes = <&gce 13 0xffffffff 1>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "gce", "gce-timer";
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			iommus = <&mdp_iommu 0x401>;
			dma_mask_bit = <0x22>;
		};

		/*
		 * GCE_M (0x1e990000) is the second CMDQ engine, reserved for the
		 * multimedia/ISP (imgsys) path.  The display GCE is @1e980000.
		 * Downstream uses &gce for display and &gce_m for imgsys; keeping
		 * them separate is required so imgsys cannot claim the display's
		 * CMDQ threads (mbox 0..6,22).
		 */
		gce_m: gce@1e990000 {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "mediatek,mt6895-gce";
			reg = <0x1e990000 0x4000>;
			interrupts = <GIC_SPI 400 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <3>;
			#gce-event-cells = <1>;
			#gce-subsys-cells = <2>;
			default_tokens = /bits/ 16 <0x2bc 0x2bd 0x2be 0x2bf 0x2c0
						     0x2c6 0x2c7 0x2aa 0x2ad 0x2b0
						     0x2b3>;
			power-domains = <&spm 6>;
			mediatek,smi = <&smi_mdp_comm>;
			unprepare_in_idle;
			gce_in_vcp;
			mboxes = <&gce_m 13 0xffffffff 1>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "gce", "gce-timer";
			dma-ranges = <0x0 0x0 0x0 0x4 0x0>;
			iommus = <&mdp_iommu M4U_LARB32_GCE_MM>;
			dma_mask_bit = <0x22>;
		};

		/*
		 * SMI (smart multimedia interface) common/sub-common tree for the
		 * display/MDP/sysram path, matching downstream MT6895.
		 * Suppliers are declared before consumers so the SMI driver can
		 * probe the whole tree without deferred-probe reordering.
		 * LARBs reference both their top-level common and their local
		 * display sub-common; the downstream SMI driver links both.
		 */
		smi_infra_disp_subcommon0: smi_infra_disp_subcomm0@1e809000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e809000 0x1000>;
			mediatek,common-id = <3>;
			init-power-on;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_infra_disp_subcommon1: smi_infra_disp_subcomm1@1e80a000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80a000 0x1000>;
			mediatek,common-id = <4>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_mdp_subcommon4: smi_mdp_subcomm4@1e817000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e817000 0x1000>;
			mediatek,common-id = <5>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_mdp_subcommon5: smi_mdp_subcomm5@1e818000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e818000 0x1000>;
			mediatek,common-id = <6>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_subcommon3: smi_sysram_subcomm3@1e80d000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80d000 0x1000>;
			mediatek,common-id = <8>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
			clock-names = "apb", "smi", "gals0", "gals1";
		};
		smi_sysram_subcommon4: smi_sysram_subcomm4@1e80e000 {
			compatible = "mediatek,mt6895-smi-common",
				"mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
			reg = <0x1e80e000 0x1000>;
			mediatek,common-id = <9>;
			power-domains = <&spm 6>;
			clocks = <&mminfra_config CLK_MMINFRA_GCE_D>,
				 <&mminfra_config CLK_MMINFRA_GCE_M>,
				 <&mminfra_config CLK_MMINFRA_SMI>,
				 <&mminfra_config CLK_MMINFRA_GCE_26M>;
