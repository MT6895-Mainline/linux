	seninf_top: seninf_top@1a010000 {
		compatible = "mediatek,seninf-core";
		reg = <0x1a010000 0x20000>,
			<0x11c80000 0x20000>;
		reg-names = "base", "ana-rx";
		seninf_num = <10>;
		mux_num = <17>;
		cam_mux_num = <23>;
		pref_mux_num = <13>;

		interrupts = <GIC_SPI 444 IRQ_TYPE_LEVEL_HIGH 0>;

		power-domains = <&spm MT6895_POWER_DOMAIN_ISP_MAIN>,
		<&spm MT6895_POWER_DOMAIN_CAM_MAIN>;

		operating-points-v2 = <&opp_table_cam>;
		/* XAGA: see camisp above - vmm_proxy_label has no driver */
		/*
		 * PEARL: dvfsrc-vmm-supply is intentionally left out so the
		 * consumer gets a dummy regulator, i.e. the "DFS without
		 * voltage scaling" mode that xaga's comment above describes.
		 * The full DVFSRC driver has been bound since the xaga merge and
		 * this board is verified stable in this configuration.
		 */
		/* dvfsrc-vmm-supply = <&dvfsrc_vcore>; */

		clocks =
			<&cam_main_r1a_clk CLK_CAM_MAIN_SENINF_CON>,
			 <&topckgen CLK_TOP_SENINF_SEL>,
			 <&topckgen CLK_TOP_SENINF1_SEL>,
			 <&topckgen CLK_TOP_SENINF2_SEL>,
			 <&topckgen CLK_TOP_SENINF3_SEL>,
			 <&topckgen CLK_TOP_SENINF4_SEL>,
			 <&topckgen CLK_TOP_CAMTM_SEL>;
		clock-names = "clk_cam_seninf",
			 "clk_top_seninf",
			 "clk_top_seninf1",
			 "clk_top_seninf2",
			 "clk_top_seninf3",
			 "clk_top_seninf4",
			 "clk_top_camtm";
	};

