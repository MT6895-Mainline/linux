// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
/*
 * MediaTek MT6895 SoC device tree source
 *
 * Based on the downstream MT6895 kernel device tree and on the upstream
 * MT6878 SoC device tree. Addresses and IRQ numbers come from the
 * downstream source (drivers/pinctrl/mediatek, arch/arm64/boot/dts).
 *
 * The CPU topology is the MediaTek 4-3-1 configuration:
 *   cluster0: 4x Cortex-A55
 *   cluster1: 3x Cortex-A78
 *   cluster2: 1x Cortex-A78
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/mfd/mt6375.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/reset/ti-syscon.h>
#include <dt-bindings/usb/pd.h>
#include <dt-bindings/power/mt6895-power.h>
#include <dt-bindings/clock/mt6895-clk.h>
#include <dt-bindings/gce/mt6895-gce.h>
#include <dt-bindings/memory/mtk-memory-port.h>
#include <dt-bindings/memory/mt6895-larb-port.h>
#include <dt-bindings/interconnect/mtk,mmqos.h>
#include <dt-bindings/interconnect/mtk,mt6873-emi.h>
#include "mt6895-pinfunc.h"

/ {
	compatible = "mediatek,mt6895";
	#address-cells = <2>;
	#size-cells = <1>;

	interrupt-parent = <&gic>;

	aliases {
		mutex0 = &disp_mutex;
		ovl0 = &disp_ovl0;
		ovl1 = &disp_ovl1;
		ovl3 = &disp_ovl0_2l;
		ovl4 = &disp_ovl1_2l;
		ovl5 = &disp_ovl2_2l;
		ovl6 = &disp_ovl3_2l;
		rdma0 = &disp_rdma0;
		rdma1 = &disp_rdma1;
		rdma2 = &disp_rdma2;
		rdma3 = &disp_rdma3;
		rsz0 = &disp_rsz0;
		rsz1 = &disp_rsz1;
		tdshp0 = &disp_tdshp0;
		tdshp1 = &disp_tdshp1;
		c3d0 = &disp_c3d0;
		c3d1 = &disp_c3d1;
		color0 = &disp_color0;
		color1 = &disp_color1;
		ccorr0 = &disp_ccorr0;
		ccorr1 = &disp_ccorr1;
		ccorr2 = &disp_ccorr2;
		ccorr3 = &disp_ccorr3;
		maal0 = &disp_dmdp_aal0;
		maal1 = &disp_dmdp_aal1;
		aal0 = &disp_aal0;
		aal1 = &disp_aal1;
		gamma0 = &disp_gamma0;
		gamma1 = &disp_gamma1;
		postmask0 = &disp_postmask0;
		postmask1 = &disp_postmask1;
		dither0 = &disp_dither0;
		dither1 = &disp_dither1;
		cm0 = &disp_cm0;
		cm1 = &disp_cm1;
		spr0 = &disp_spr0;
		spr1 = &disp_spr1;
		chist0 = &disp_chist0;
		chist1 = &disp_chist1;
		chist2 = &disp_chist2;
		chist3 = &disp_chist3;
		dsc0 = &disp_dsc0;
		dsc1 = &disp_dsc1_wrap;
		merge0 = &disp_merge0;
		merge1 = &disp_merge1;
		dsi0 = &dsi0;
		wdma0 = &disp_wdma0;
		wdma1 = &disp_wdma1;
		wdma2 = &disp_wdma2;
		wdma3 = &disp_wdma3;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
				core2 {
					cpu = <&cpu6>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu7>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x0>;
			enable-method = "psci";
			performance-domains = <&cpufreq 0>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l>;
			capacity-dmips-mhz = <380>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			performance-domains = <&cpufreq 0>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l>;
			capacity-dmips-mhz = <380>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			performance-domains = <&cpufreq 0>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l>;
			capacity-dmips-mhz = <380>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			performance-domains = <&cpufreq 0>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l>;
			capacity-dmips-mhz = <380>;
		};

		cpu4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x400>;
			enable-method = "psci";
			performance-domains = <&cpufreq 1>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b>;
			capacity-dmips-mhz = <1024>;
		};

		cpu5: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x500>;
			enable-method = "psci";
			performance-domains = <&cpufreq 1>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b>;
			capacity-dmips-mhz = <1024>;
		};

		cpu6: cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x600>;
			enable-method = "psci";
			performance-domains = <&cpufreq 1>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b>;
			capacity-dmips-mhz = <1024>;
		};

		cpu7: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x700>;
			enable-method = "psci";
			performance-domains = <&cpufreq 2>;
			cpu-supply = <&vproc>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b>;
			capacity-dmips-mhz = <1024>;
		};

	
		/*
		 * MT6895 PSCI idle states.  mainline shipped none, so the CPUs only
		 * ever did WFI and the SoC never entered mcusysoff.
		 *
		 * Taken from the downstream crdroid mt6895.dts via the xaga branch
		 * (commit a8899c4dac).  xaga measured that mcusys-off is entered and
		 * accumulates residency but that idle power did not move -- the CPU
		 * idle path is not this platform's bottleneck (DRAM is, see the
		 * DRAM bandwidth floor), so treat this set as a correctness/latency
		 * improvement rather than the power fix.
		 *
		 * The deeper system_mem/system_pll/system_bus (dpidle) and s2idle
		 * states are deliberately left out: they need SPM support that is not
		 * ported for mt6895 yet.
		 */
		idle-states {
			entry-method = "psci";

			cpuoff_l: cpu-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010001>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1600>;
			};

			cpuoff_b: cpu-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010002>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1400>;
			};

			clusteroff_l: cluster-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010101>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <2100>;
			};

			clusteroff_b: cluster-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010102>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <1900>;
			};

			/*
			 * PEARL: mcusys-off is deliberately NOT referenced by any CPU.
			 *
			 * Entering it powers down the whole MCUSYS domain, which contains
			 * MMINFRA/SMI/EMI, so the display controller underruns on every frame
			 * ("DDP_COMPONENT_OVL*: frame underflow") and phoc gives up on DSI-1.
			 * Measured on pearl: 182 underruns/s with it enabled, 0 without.
			 * cpu-off and cluster-off are kept -- they do not touch the MM domain.
			 *
			 * mcusysoff: mcusys-off {
			 * compatible = "arm,idle-state";
			 * arm,psci-suspend-param = <0x01010701>;
			 * local-timer-stop;
			 * entry-latency-us = <450>;
			 * exit-latency-us = <600>;
			 * min-residency-us = <4000>;
			 * };
			 */
		};
};

	clk13m: clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <13000000>;
		clock-output-names = "clk13m";
	};

	clk26m: clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	clk32k: clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32000>;
		clock-output-names = "clk32k";
	};

	/*
	 * i2c5 clock stubs. The real sources are i2c_sel (topckgen CLK_CFG_11
	 * bits 8-9, default parent tck_26m = 26MHz) -> i2c_ck, gated by
	 * imp_iic_wrap_c (bit0), and the apdma gate in pericfg_ao (bit5).
	 * There is no mt6895 clock driver yet, so these fixed clocks only
	 * satisfy the i2c-mt65xx probe (clk_prepare_enable = no-op). The real
	 * gates are forced on by pearl_i2c_power_on() in setup.c (LK also uses
	 * i2c5 for the off-mode mt6375 charging animation). The main rate is
	 * used to derive SCL timing; 26MHz matches the default mux parent.
	 */
	clk_i2c5_main: clock-i2c5-main {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "i2c5-main";
	};

	clk_i2c_dma: clock-i2c-dma {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <208000000>;
		clock-output-names = "i2c-dma";
	};

	/*
	 * SPMI (PMIF) clock stubs. The real sources are the vlp_cksys pmif
	 * muxes/gates (0x1c013000); LK already enables them to talk to the
	 * MT6363 PMIC over SPMI during boot, so fixed clocks only satisfy
	 * spmi-mtk-pmif's clk_bulk_get (prepare_enable = no-op).
	 */
	clk_pmif_sys: clock-pmif-sys {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "pmif-sys";
	};

	clk_pmif_tmr: clock-pmif-tmr {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "pmif-tmr";
	};

	clk_spmimst: clock-spmimst-mux {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spmimst-mux";
	};

	/*
	 * DISP0/DISP1 are now provided by the real MT6895 topckgen driver
	 * (clk-mt6895.c), so the old fixed-clock stubs must NOT be present:
	 * they collide with clk_hw_register_fixed_factor("disp0_ck"/"disp1_ck")
	 * and abort registration of the whole top_divs table (including
	 * mminfra_ck), which breaks GCE/MMINFRA clock parenting.
	 *
	 * hf_fdisp2_ck is not a topckgen factor, so keep the fixed stub for
	 * the MM1_SIG_EMI gate parent.
	 */
	hf_fdisp2_ck: clock-hf-fdisp2 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <400000000>;
		clock-output-names = "hf_fdisp2_ck";
	};

	/*
	 * SPI2 clock stubs. Real sources: SPI_SEL mux (topckgen CLK_CFG_7
	 * @0x10000080 bits 16-18) -> spi2_bclk, gated by perao0
	 * (@0x11036000+0x3c bit 19, active-low). spi-mt65xx requires
	 * clk_set_parent(sel, parent) and clk_get_rate(spi_clk) for divider
	 * math; the embedded DTS stubs the mux input at 26MHz and setup.c
	 * forces SPI_SEL to parent 0 (tck_26m, 26MHz) + enables the gate,
	 * matching the fixed rates here.
	 */
	clk_spi2_parent: clock-spi2-parent {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi2-parent";
	};

	clk_spi2_sel: clock-spi2-sel {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi2-sel";
	};

	clk_spi2: clock-spi2 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi2-bclk";
	};

	/*
	 * SPI3 clock stubs（pearl 指纹挂 SPI3）。与 SPI2 同样桩在 26MHz；
	 * 真实门控是 perao0 @0x11036000+0x3c 的 bit 20（SPI2 是 bit 19，
	 * 见 vendor clk-mt6895-peri.c）。
	 */
	clk_spi3_parent: clock-spi3-parent {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi3-parent";
	};

	clk_spi3_sel: clock-spi3-sel {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi3-sel";
	};

	clk_spi3: clock-spi3 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "spi3-bclk";
	};

	/*
	 * CPU DVFS supply stub: mediatek-cpufreq-hw requires a cpu-supply
	 * regulator on every CPU to probe (devm_regulator_get). Actual CPU
	 * voltage is stepped by the DVFS firmware via SPM/EMI, so a fixed
	 * always-on regulator is sufficient.
	 */
	vproc: regulator-vproc {
		compatible = "regulator-fixed";
		regulator-name = "vproc";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <800000>;
		regulator-always-on;
	};

	/*
	 * Stub GPU regulator: panthor calls dev_pm_opp_set_regulators() with
	 * names[] = { "mali" }, which fails the probe if no mali-supply exists.
	 * A fixed regulator satisfies the OPP core; the real VGPU rail is left
	 * at whatever LK configured.
	 *
	 * regulator-fixed REJECTS a node with variable voltages
	 * (drivers/regulator/fixed.c:187-193: min_uV != max_uV -> -EINVAL,
	 * probe fails, regulator never registers). So min MUST equal max.
	 */
	vdd_gpu: regulator-gpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_gpu";
		regulator-min-microvolt = <750000>;
		regulator-max-microvolt = <750000>;
		regulator-always-on;
	};

	/* Panel 1.8V IO supply stub (LK leaves it powered) */
	vrf18_reg: regulator-vrf18 {
		compatible = "regulator-fixed";
		regulator-name = "vrf18";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/*
	 * GPU OPP table from the downstream MT6895 gpufreq table.
	 *
	 * The current vdd_gpu is a fixed stub (LK leaves the real VGPU/VCORE
	 * rail powered), so all OPPs use the fixed stub voltage.  Once a real
	 * variable VGPU regulator/DVFSRC path is ported, replace these with the
	 * downstream per-OPP microvolt values.
	 *
	 * The clock is now the real topckgen MFG_SEL_0 output, so devfreq can
	 * set the MFGPLL and mux to these rates.
	 */
	/*
	 * Multimedia OPP tables. The frequencies are the topckgen mux
	 * parents that the vendor mmdvfs driver selects per voltage
	 * step; the voltages are the VCORE steps of the DVFSRC
	 * regulator. Requests are aggregated, so a client may keep a
	 * low OPP while another one holds the rail high.
	 */
	opp_table_venc: opp-table-venc {
		compatible = "operating-points-v2";

		opp-249600000 {
			opp-hz = /bits/ 64 <249600000>;
			opp-microvolt = <575000>;
		};
		opp-312000000 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <600000>;
		};
		opp-458333313 {
			opp-hz = /bits/ 64 <458333313>;
			opp-microvolt = <650000>;
		};
		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <725000>;
		};
	};

	opp_table_vdec: opp-table-vdec {
		compatible = "operating-points-v2";

		opp-218400000 {
			opp-hz = /bits/ 64 <218400000>;
			opp-microvolt = <575000>;
		};
		opp-249600000 {
			opp-hz = /bits/ 64 <249600000>;
			opp-microvolt = <600000>;
		};
		opp-416000000 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <650000>;
		};
		opp-594000000 {
			opp-hz = /bits/ 64 <594000000>;
			opp-microvolt = <725000>;
		};
		opp-660000000 {
			opp-hz = /bits/ 64 <660000000>;
			opp-microvolt = <750000>;
		};
	};
	opp_table_disp0: opp-table-disp0 {
		compatible = "operating-points-v2";

		opp-208000000 {
			opp-hz = /bits/ 64 <208000000>;
			opp-microvolt = <575000>;
		};
		opp-249600000 {
			opp-hz = /bits/ 64 <249600000>;
			opp-microvolt = <600000>;
		};
		opp-436800000 {
			opp-hz = /bits/ 64 <436800000>;
			opp-microvolt = <650000>;
		};
		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <725000>;
		};
	};

	opp_table_mminfra: opp-table-mminfra {
		compatible = "operating-points-v2";

		opp-218400000 {
			opp-hz = /bits/ 64 <218400000>;
			opp-microvolt = <575000>;
		};
		opp-273000000 {
			opp-hz = /bits/ 64 <273000000>;
			opp-microvolt = <600000>;
		};
		opp-436800000 {
			opp-hz = /bits/ 64 <436800000>;
			opp-microvolt = <650000>;
		};
		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <725000>;
		};
		opp-687499969 {
			opp-hz = /bits/ 64 <687499969>;
			opp-microvolt = <750000>;
		};
	};

	vcp_vdec_dma: vcp-vdec-dma {
		compatible = "mediatek,mt6895-vcp-vdec-dma";
		iommus = <&mdp_iommu 0x50420>;
	};

	vdec_ube_dma: vdec-ube-dma {
		compatible = "mediatek,mt6895-vdec-ube-dma";
		iommus = <&disp_iommu 0x100a5>;
	};

	vcp_venc_dma: vcp-venc-dma {
		compatible = "mediatek,mt6895-vcp-venc-dma";
		/* table0, video domain6, pseudo-larb33, port1 */
		iommus = <&mdp_iommu 0x60421>;
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";
		opp-950000000 {
			opp-hz = <0 950000000>;
			opp-microvolt = <750000>;
		};
		opp-860000000 {
			opp-hz = <0 860000000>;
			opp-microvolt = <750000>;
		};
		opp-852000000 {
			opp-hz = <0 852000000>;
			opp-microvolt = <750000>;
		};
		opp-845000000 {
			opp-hz = <0 845000000>;
			opp-microvolt = <750000>;
		};
		opp-837000000 {
			opp-hz = <0 837000000>;
			opp-microvolt = <750000>;
		};
		opp-830000000 {
			opp-hz = <0 830000000>;
			opp-microvolt = <750000>;
		};
		opp-822000000 {
			opp-hz = <0 822000000>;
			opp-microvolt = <750000>;
		};
		opp-815000000 {
			opp-hz = <0 815000000>;
			opp-microvolt = <750000>;
		};
		opp-807000000 {
			opp-hz = <0 807000000>;
			opp-microvolt = <750000>;
		};
		opp-800000000 {
			opp-hz = <0 800000000>;
			opp-microvolt = <750000>;
		};
		opp-773000000 {
			opp-hz = <0 773000000>;
			opp-microvolt = <750000>;
		};
		opp-747000000 {
			opp-hz = <0 747000000>;
			opp-microvolt = <750000>;
		};
		opp-721000000 {
			opp-hz = <0 721000000>;
			opp-microvolt = <750000>;
		};
		opp-695000000 {
			opp-hz = <0 695000000>;
			opp-microvolt = <750000>;
		};
		opp-668000000 {
			opp-hz = <0 668000000>;
			opp-microvolt = <750000>;
		};
		opp-642000000 {
			opp-hz = <0 642000000>;
			opp-microvolt = <750000>;
		};
		opp-616000000 {
			opp-hz = <0 616000000>;
			opp-microvolt = <750000>;
		};
		opp-590000000 {
			opp-hz = <0 590000000>;
			opp-microvolt = <750000>;
		};
		opp-572000000 {
			opp-hz = <0 572000000>;
			opp-microvolt = <750000>;
		};
		opp-555000000 {
			opp-hz = <0 555000000>;
			opp-microvolt = <750000>;
		};
