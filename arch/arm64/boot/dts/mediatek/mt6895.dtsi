			power-domains = <&spm 17>;
			clocks = <&mdpsys_config_clk CLK_MDP_SMI0>, <&mdpsys_config_clk CLK_MDP_SMI0>;
			clock-names = "apb", "smi";
		};

		smi_larb3: smi_larb3@1f802000 {
